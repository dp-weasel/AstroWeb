---
import Logo from "./Logo.astro";

interface Props {
  title: string;
  subtitle?: string;
  /** Versión reducida para páginas internas: sin logo y con el título más chico. */
  compact?: boolean;
}
const { title, subtitle, compact = false } = Astro.props;
---

<section class:list={["hero", { compact }]}>
  {!compact && <Logo />}
  <h1>{title}</h1>
  {subtitle && <p class="subtitle">{subtitle}</p>}
</section>

<style>
  .hero {
    text-align: center;
    padding: 3rem 1rem 2rem;
  }
  h1 {
    margin: 0;
    font-family: var(--font-display);
    /* Archivo Black ya es una fuente "black"; pedir más peso provoca negrita sintética. */
    font-weight: 400;
    font-size: clamp(2.75rem, 11vw, 4.25rem);
    line-height: 1;
    letter-spacing: -0.02em;
    background: linear-gradient(90deg, var(--accent-strong), var(--amber));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .subtitle { color: var(--muted); margin: 1rem 0 0; }

  .compact { padding: 2rem 1rem 1.5rem; }
  .compact h1 { font-size: clamp(2rem, 8vw, 3.5rem); }
</style>
