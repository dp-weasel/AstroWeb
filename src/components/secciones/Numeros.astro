---
// Números del canal en una banda. Por defecto, los de `numeros`; se le pueden
// pasar otros (p. ej. la franja de la variante 6).
import { numeros, inicioCanal, type DatoFranja } from "../../data/contenido";
import Ejemplo from "./Ejemplo.astro";

interface Props {
  items?: DatoFranja[];
}
const { items = numeros as DatoFranja[] } = Astro.props;
---

<div class="numeros" data-inicio={inicioCanal}>
  <dl>
    {items.map((n) => (
      <div><dd data-auto={n.auto}>{n.valor}</dd><dt>{n.etiqueta}</dt></div>
    ))}
  </dl>
  <Ejemplo />
</div>

<style>
  .numeros { text-align: center; }
  dl { margin: 0 0 .5rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: 1rem; }
  dl div { padding: 1rem .5rem; }
  dd { margin: 0; font-family: var(--font-brand); font-size: clamp(2.2rem, 6vw, 3.25rem); line-height: 1; color: var(--accent); font-variant-numeric: tabular-nums; }
  dt { margin-top: .35rem; font-family: var(--font-title); font-weight: 900; font-style: italic; text-transform: uppercase; font-size: .8rem; color: var(--muted); }
</style>

<script>
  // "Día N de la aventura": se recalcula al abrir la página, así no queda
  // congelado en el día en que se compiló el sitio.
  for (const el of document.querySelectorAll<HTMLElement>(".numeros")) {
    const inicio = Date.parse(`${el.dataset.inicio}T00:00:00-03:00`);
    const dia = Math.floor((Date.now() - inicio) / 864e5) + 1;
    el.querySelectorAll('[data-auto="dia"]').forEach((dd) => (dd.textContent = `Día ${dia}`));
  }
</script>
