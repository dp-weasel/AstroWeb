---
// Formas de apoyar al canal: gratis primero, después Cafecito.
import { apoyar } from "../../data/contenido";
import Ejemplo from "./Ejemplo.astro";
---

<div class="apoyar">
  <ul>
    {apoyar.gratis.map((a) => (
      <li><span class="emoji" aria-hidden="true">{a.emoji}</span><strong>{a.que}</strong><span>{a.detalle}</span></li>
    ))}
  </ul>
  <a class="cafecito" href={apoyar.cafecito.url} target="_blank" rel="noopener">
    <span class="taza" aria-hidden="true">☕</span>
    <span><strong>{apoyar.cafecito.texto}</strong><small>{apoyar.cafecito.nota}</small></span>
    <Ejemplo texto="Falta tu enlace" />
  </a>
  <p class="nota">Todo lo de arriba es gratis y ayuda igual que una donación. En serio.</p>
</div>

<style>
  ul { list-style: none; margin: 0 0 1rem; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: .75rem; }
  li { display: grid; gap: .25rem; padding: 1rem; border-radius: 1rem; background: var(--surface); }
  .emoji { font-size: 1.6rem; }
  li span:last-child { color: var(--muted); font-size: .9rem; }
  .cafecito {
    display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1rem;
    padding: 1rem 1.25rem; border-radius: 1rem;
    background: var(--cream); color: var(--charcoal); text-decoration: none;
    border: 3px solid var(--charcoal); box-shadow: .35rem .35rem 0 var(--amber);
    transition: transform .15s, box-shadow .15s;
  }
  .cafecito:hover { transform: translate(-2px, -2px); box-shadow: .5rem .5rem 0 var(--amber); }
  .taza { font-size: 2rem; }
  .cafecito strong { display: block; font-family: var(--font-bubble); font-size: 1.2rem; }
  .cafecito small { font-family: var(--font-bubble); font-weight: 600; color: #6b5f50; }
  .cafecito :global(.ejemplo) { margin-left: auto; color: #6b5f50; }
  .nota { margin: .75rem 0 0; text-align: center; color: var(--muted); font-size: .9rem; }
</style>
