---
// "El rincón": el setup, con el mate incluido.
import { rincon } from "../../data/contenido";
import Ejemplo from "./Ejemplo.astro";
---

<div class="rincon">
  <ul>
    {rincon.map((r) => (
      <li><span class="emoji" aria-hidden="true">{r.emoji}</span><div><strong>{r.que}</strong><p>{r.detalle}</p></div></li>
    ))}
  </ul>
  <Ejemplo />
</div>

<style>
  ul { list-style: none; margin: 0 0 .5rem; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: .75rem; }
  li { display: flex; gap: .9rem; align-items: flex-start; padding: 1rem; border-radius: 1rem; background: var(--surface); }
  .emoji { flex: none; display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: .8rem; background: var(--bg); font-size: 1.4rem; }
  p { margin: .15rem 0 0; color: var(--muted); font-size: .92rem; }
</style>
