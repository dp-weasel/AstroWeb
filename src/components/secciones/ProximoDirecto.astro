---
// Cuenta regresiva al próximo directo según el horario (hora de Argentina).
// Si según el horario se está transmitiendo, muestra "En vivo ahora".
import { horario, dias } from "../../data/contenido";
import Ejemplo from "./Ejemplo.astro";
import { socials } from "../../data/profile";

interface Props { class?: string }
const { class: extra } = Astro.props;
const twitch = socials[0];
---

<a class:list={["proximo", extra]} href={twitch.url} target="_blank" rel="noopener" data-horario={JSON.stringify(horario)} data-dias={JSON.stringify(dias)}>
  <span class="estado"><span class="dot"></span> <span data-estado>Próximo directo</span></span>
  <strong class="cuando" data-cuando>Mirá el horario</strong>
  <span class="cuenta" data-cuenta aria-live="off"></span>
  <span class="plan" data-plan></span>
  <Ejemplo />
</a>

<style>
  .proximo {
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: .25rem 1rem;
    padding: 1rem 1.25rem; border-radius: 1rem;
    background: var(--charcoal); color: var(--snow); text-decoration: none;
    border: 2px solid var(--amber);
    box-shadow: 0 .5rem 1.5rem rgb(0 0 0 / .25);
    transition: transform .15s;
  }
  .proximo:hover { transform: translateY(-2px); }
  .estado { grid-row: span 2; display: flex; align-items: center; gap: .4rem; color: var(--amber); font-family: var(--font-title); font-weight: 900; font-style: italic; text-transform: uppercase; font-size: .8rem; max-width: 7rem; line-height: 1.1; }
  .dot { flex: none; width: .65rem; height: .65rem; border-radius: 50%; background: #777; }
  .vivo .dot { background: #e91916; animation: pulse 1s infinite; }
  .vivo .estado { color: #ff5b5b; }
  @keyframes pulse { 50% { opacity: .3; } }
  .cuando { font-size: 1.1rem; }
  .cuenta { grid-row: span 2; font-family: var(--font-brand); font-size: clamp(1.3rem, 4vw, 1.8rem); color: var(--amber); font-variant-numeric: tabular-nums; }
  .plan { color: #bdbdbd; font-size: .9rem; }
  .proximo :global(.ejemplo) { grid-column: 1 / -1; justify-self: start; color: #888; }
  @media (max-width: 30rem) {
    .proximo { grid-template-columns: 1fr; text-align: center; justify-items: center; }
    .estado, .cuenta { grid-row: auto; max-width: none; }
    .proximo :global(.ejemplo) { justify-self: center; }
  }
  @media (prefers-reduced-motion: reduce) { .dot { animation: none !important; } }
</style>

<script>
  type Directo = { dia: number; hora: string; duracionHoras: number; plan: string };
  const AR = -3; // UTC−3

  for (const el of document.querySelectorAll<HTMLElement>(".proximo")) {
    const horario: Directo[] = JSON.parse(el.dataset.horario!);
    const dias: string[] = JSON.parse(el.dataset.dias!);
    const $ = (k: string) => el.querySelector<HTMLElement>(`[data-${k}]`)!;

    // Próximos inicios (en ms UTC) de cada directo de la semana.
    function inicios(ahora: number) {
      const out: { t: number; d: Directo }[] = [];
      const hoyAR = new Date(ahora + AR * 3600e3);
      for (let k = -1; k < 8; k++) {
        const base = Date.UTC(hoyAR.getUTCFullYear(), hoyAR.getUTCMonth(), hoyAR.getUTCDate() + k);
        const diaSemana = new Date(base).getUTCDay();
        for (const d of horario.filter((h) => h.dia === diaSemana)) {
          const [h, m] = d.hora.split(":").map(Number);
          out.push({ t: base + (h - AR) * 3600e3 + m * 60e3, d });
        }
      }
      return out.sort((a, b) => a.t - b.t);
    }

    function tic() {
      const ahora = Date.now();
      const lista = inicios(ahora);
      const enCurso = lista.find((x) => x.t <= ahora && ahora < x.t + x.d.duracionHoras * 3600e3);
      if (enCurso) {
        el.classList.add("vivo");
        $("estado").textContent = "En vivo ahora";
        $("cuando").textContent = "¡Entrá, que ya arrancó!";
        $("cuenta").textContent = "▶";
        $("plan").textContent = enCurso.d.plan;
        return;
      }
      el.classList.remove("vivo");
      const prox = lista.find((x) => x.t > ahora);
      if (!prox) return;
      const falta = prox.t - ahora;
      const d = Math.floor(falta / 864e5), h = Math.floor(falta / 36e5) % 24, m = Math.floor(falta / 6e4) % 60, s = Math.floor(falta / 1e3) % 60;
      const dos = (n: number) => String(n).padStart(2, "0");
      $("estado").textContent = "Próximo directo";
      $("cuando").textContent = `${dias[prox.d.dia]} ${prox.d.hora} (AR)`;
      $("cuenta").textContent = d > 0 ? `${d}d ${dos(h)}:${dos(m)}:${dos(s)}` : `${dos(h)}:${dos(m)}:${dos(s)}`;
      $("plan").textContent = prox.d.plan;
    }
    tic();
    setInterval(tic, 1000);
  }
</script>
