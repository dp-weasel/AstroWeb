---
// Reglas del chat, numeradas.
import { reglas } from "../../data/contenido";
import Ejemplo from "./Ejemplo.astro";
---

<div class="reglas">
  <ol>
    {reglas.map((r) => (
      <li><strong>{r.titulo}</strong><span>{r.texto}</span></li>
    ))}
  </ol>
  <Ejemplo />
</div>

<style>
  ol { list-style: none; counter-reset: r; margin: 0 0 .5rem; padding: 0; display: grid; gap: .75rem; }
  li { counter-increment: r; position: relative; display: grid; padding: .8rem 1rem .8rem 3.75rem; border-radius: .9rem; background: var(--surface); }
  li::before {
    content: counter(r); position: absolute; left: .9rem; top: 50%; transform: translateY(-50%);
    display: grid; place-items: center; width: 2.1rem; height: 2.1rem; border-radius: 50%;
    background: var(--amber); color: var(--charcoal); font-family: var(--font-brand); font-size: 1.1rem;
  }
  strong { font-weight: 800; }
  span { color: var(--muted); }
</style>
