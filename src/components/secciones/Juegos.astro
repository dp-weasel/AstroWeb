---
// El juego principal y una "votación" de qué jugar los sábados.
import { juegoPrincipal, proximos } from "../../data/contenido";
import Ejemplo from "./Ejemplo.astro";

const total = proximos.reduce((n, p) => n + p.votos, 0);
const max = Math.max(...proximos.map((p) => p.votos));
---

<div class="juegos">
  <article class="principal">
    <span class="tag">Juego de la casa</span>
    <h3>{juegoPrincipal.nombre}</h3>
    <p>{juegoPrincipal.texto}</p>
    <ul class="modos">{juegoPrincipal.modos.map((m) => <li>{m}</li>)}</ul>
  </article>
  <article class="votacion">
    <span class="tag">¿Qué jugamos el sábado?</span>
    <ul>
      {proximos.map((p) => (
        <li class:list={{ gana: p.votos === max }}>
          <span class="barra" style={`--pct: ${Math.round((p.votos / total) * 100)}%`}></span>
          <span class="nombre">{p.nombre}</span>
          <span class="pct">{Math.round((p.votos / total) * 100)} %</span>
        </li>
      ))}
    </ul>
    <p class="nota">Se vota en el chat durante el directo. <Ejemplo /></p>
  </article>
</div>

<style>
  .juegos { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  article { padding: 1.5rem; border-radius: 1.25rem; background: var(--surface); }
  .principal {
    background: linear-gradient(145deg, color-mix(in srgb, var(--vermilion) 35%, var(--surface)), var(--surface) 70%);
  }
  .tag { font-family: var(--font-title); font-weight: 900; font-style: italic; text-transform: uppercase; font-size: .8rem; color: var(--accent); }
  h3 { margin: .25rem 0 .5rem; font-family: var(--font-brand); font-weight: 400; font-size: 2rem; line-height: 1.05; }
  p { color: var(--muted); margin: 0 0 1rem; }
  .modos { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .4rem; }
  .modos li { padding: .2rem .7rem; border-radius: 999px; border: 1px solid var(--border); background: var(--bg); font-size: .85rem; font-weight: 600; }
  .votacion ul { list-style: none; margin: .75rem 0; padding: 0; display: grid; gap: .5rem; }
  .votacion li { position: relative; display: flex; justify-content: space-between; gap: 1rem; padding: .55rem .8rem; border-radius: .6rem; background: var(--bg); overflow: hidden; font-weight: 600; font-size: .95rem; }
  .barra { position: absolute; inset: 0 auto 0 0; width: var(--pct); background: color-mix(in srgb, var(--amber) 25%, transparent); }
  .gana .barra { background: color-mix(in srgb, var(--amber) 45%, transparent); }
  .nombre, .pct { position: relative; }
  .pct { font-family: var(--font-brand); font-weight: 400; color: var(--accent); }
  .nota { font-size: .8rem; margin: 0; }
  @media (max-width: 44rem) { .juegos { grid-template-columns: 1fr; } }
</style>
