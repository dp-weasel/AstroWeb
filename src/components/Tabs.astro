---
import type { Category } from "../lib/messages";
import MessageCard from "./MessageCard.astro";

interface Props {
  categories: Category[];
}
const { categories } = Astro.props;
---

<div data-tabs>
  <nav class="tabs" role="tablist" aria-label="Categorías">
    {
      categories.map((c, i) => (
        <button
          type="button"
          class="tab"
          role="tab"
          id={`tab-${c.id}`}
          data-tab-id={c.id}
          aria-controls={`panel-${c.id}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
        >
          <span class="tab-name">{c.name}</span>
          <span class="tab-count" data-tab-count hidden></span>
        </button>
      ))
    }
  </nav>

  {
    categories.map((c, i) => (
      <div role="tabpanel" id={`panel-${c.id}`} aria-labelledby={`tab-${c.id}`} hidden={i !== 0}>
        <ul class="messages">
          {c.messages.map((text) => (
            <MessageCard text={text} />
          ))}
        </ul>
        <p class="empty" role="status" data-empty hidden />
      </div>
    ))
  }
</div>

<script>
  import { initTabs } from "../scripts/tabs";
  initTabs(document.querySelector("[data-tabs]") as HTMLElement);
</script>

<style>
  .tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: .5rem;
    margin-bottom: 1.5rem;
  }
  .tab {
    font: 600 .95rem var(--font-body);
    padding: .55rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
    transition: background-color .15s, border-color .15s, color .15s;
  }
  .tab:hover { border-color: var(--accent); }
  .tab[aria-selected="true"] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
  .tab-count {
    display: inline-block;
    min-width: 1.4em;
    margin-left: .4rem;
    padding: 0 .35em;
    border-radius: 999px;
    font-size: .8em;
    background: var(--border);
    color: var(--text);
  }
  .tab[aria-selected="true"] .tab-count { background: rgb(0 0 0 / .18); color: inherit; }

  .messages {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: .75rem;
  }
  .empty {
    text-align: center;
    color: var(--muted);
    padding: 1.5rem 1rem;
    border: 1px dashed var(--border);
    border-radius: .5rem;
    margin: 0;
  }
</style>
