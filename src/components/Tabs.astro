---
import type { Category } from "../lib/messages";
import { CUSTOM_TAB } from "../lib/gw2";
import MessageCard from "./MessageCard.astro";
import MessageEditor from "./MessageEditor.astro";

interface Props {
  categories: Category[];
}
// Las pestañas publicadas más la de mensajes propios, que se llena en el navegador.
const tabs: Category[] = [...Astro.props.categories, { ...CUSTOM_TAB, messages: [] }];
---

<div data-tabs>
  <nav class="tabs" role="tablist" aria-label="Categorías">
    {
      tabs.map((c, i) => (
        <button
          type="button"
          class="tab"
          role="tab"
          id={`tab-${c.id}`}
          data-tab-id={c.id}
          aria-controls={`panel-${c.id}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
        >
          <span class="tab-name">{c.name}</span>
          <span class="tab-count" data-tab-count hidden></span>
        </button>
      ))
    }
  </nav>

  {
    tabs.map((c, i) => (
      <div
        role="tabpanel"
        id={`panel-${c.id}`}
        aria-labelledby={`tab-${c.id}`}
        data-panel={c.id}
        hidden={i !== 0}
      >
        <ul class="messages" data-list>
          {c.messages.map((m) => (
            <MessageCard messageKey={m.key} text={m.text} />
          ))}
        </ul>
        <p class="empty" role="status" data-empty hidden />
        <p class="empty" data-no-messages hidden={c.messages.length > 0}>
          {c.id === CUSTOM_TAB.id
            ? "Aquí van tus propios mensajes. Se guardan solo en este navegador."
            : "No quedan mensajes en esta pestaña."}
        </p>
        <div class="panel-actions">
          <button type="button" class="panel-btn" data-action="add">
            <span aria-hidden="true">+</span> Agregar mensaje
          </button>
          <button type="button" class="panel-btn subtle" data-action="restore-deleted" hidden />
        </div>
      </div>
    ))
  }

  <template data-card-template><MessageCard messageKey="" text="" /></template>
  <template data-editor-template><MessageEditor /></template>
</div>

<p class="storage-note">
  Tus cambios (mensajes editados, eliminados o agregados) se guardan solo en este navegador.
</p>

<script>
  import { initTabs } from "../scripts/tabs";
  import { initMessageEditor } from "../scripts/messages-editor";
  const root = document.querySelector("[data-tabs]") as HTMLElement;
  initMessageEditor(root);
  initTabs(root);
</script>

<style>
  .tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: .5rem;
    margin-bottom: 1.5rem;
  }
  .tab {
    font: 600 .95rem var(--font-body);
    padding: .55rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
    transition: background-color .15s, border-color .15s, color .15s;
  }
  .tab:hover { border-color: var(--accent); }
  .tab[aria-selected="true"] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
  .tab-count {
    display: inline-block;
    min-width: 1.4em;
    margin-left: .4rem;
    padding: 0 .35em;
    border-radius: 999px;
    font-size: .8em;
    background: var(--border);
    color: var(--text);
  }
  .tab[aria-selected="true"] .tab-count { background: rgb(0 0 0 / .18); color: inherit; }

  .messages {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: .75rem;
  }
  .empty {
    text-align: center;
    color: var(--muted);
    padding: 1.5rem 1rem;
    border: 1px dashed var(--border);
    border-radius: .5rem;
    margin: 0;
  }
  [role="tabpanel"] { display: grid; gap: .75rem; }

  .panel-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: .5rem;
    margin-top: .25rem;
  }
  .panel-btn {
    font: 600 .95rem var(--font-body);
    padding: .6rem 1.2rem;
    border-radius: 999px;
    border: 1px dashed var(--accent);
    background: none;
    color: var(--accent);
    cursor: pointer;
    transition: background-color .15s;
  }
  .panel-btn:hover { background: var(--surface); }
  .panel-btn.subtle { border-color: var(--border); color: var(--muted); }
  .panel-btn.subtle:hover { color: var(--text); }

  .storage-note {
    margin: 2rem 0 0;
    text-align: center;
    font-size: .85rem;
    color: var(--muted);
  }
</style>
