<button id="theme-toggle" class="theme-toggle" type="button" aria-label="Cambiar a modo claro">
  <span aria-hidden="true" class="icon-sun">☀</span>
  <span aria-hidden="true" class="icon-moon">☾</span>
</button>

<script>
  import { initThemeToggle } from "../scripts/theme";
  initThemeToggle(document.getElementById("theme-toggle") as HTMLButtonElement);
</script>

<style>
  .theme-toggle {
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--accent);
    font-size: 1.25rem;
    cursor: pointer;
  }
  :global(:root[data-theme="dark"]) .icon-moon,
  :global(:root[data-theme="light"]) .icon-sun { display: none; }
</style>
