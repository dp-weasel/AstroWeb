---
// Los tres personajes del canal: Weasel (hueco para una foto), el Armiño y EDM.
// Textos en src/content/portada/equipo.yaml.
import { Image } from "astro:assets";
import { leer } from "../../lib/contenido";
import ArminoVivo from "../marca/ArminoVivo.astro";
import edm from "../../assets/brand/edm/saludando.png";

const { personajes } = await leer("equipo");
---

<div class="personajes">
  {personajes.map((p) => (
    <article class:list={["p", p.id]}>
      <div class="retrato">
        {p.id === "weasel" && (
          <div class="foto" title="Acá iría una foto tuya o un recorte de la cámara">
            <span aria-hidden="true">📷</span>
            <small>Tu foto acá</small>
          </div>
        )}
        {p.id === "armino" && <ArminoVivo size="11rem" />}
        {p.id === "edm" && <Image src={edm} alt="EDM saludando" width={220} />}
      </div>
      <span class="rol">{p.rol}</span>
      <h3>{p.nombre}</h3>
      <p>{p.texto}</p>
      {p.dato && <p class="dato">{p.dato}</p>}
    </article>
  ))}
</div>

<style>
  .personajes { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 1.25rem; }
  .p { position: relative; padding: 0 1.25rem 1.25rem; border-radius: 1.25rem; background: var(--surface); border-top: 5px solid var(--amber); }
  .p.edm { border-top-color: var(--magenta); }
  .retrato { height: 12rem; display: grid; place-items: end center; margin-bottom: .75rem; }
  .retrato img { width: auto; height: 11.5rem; }
  .foto {
    width: 9rem; height: 10.5rem; margin-bottom: .5rem; border-radius: 28px;
    display: grid; place-content: center; justify-items: center; gap: .25rem;
    border: 5px solid var(--charcoal); background: repeating-linear-gradient(45deg, var(--surface-hover) 0 10px, var(--surface) 10px 20px);
    box-shadow: 0 0 0 2px var(--amber); color: var(--muted); font-size: 2rem;
  }
  .foto small { font-size: .75rem; font-weight: 700; }
  .rol { display: inline-block; padding: .1rem .55rem; border-radius: .4rem; background: var(--amber); color: var(--charcoal); font-family: var(--font-label); font-size: .85rem; }
  .edm .rol { background: var(--magenta); color: #fff; }
  h3 { margin: .4rem 0 .25rem; font-family: var(--font-brand); font-weight: 400; font-size: 1.6rem; }
  p { margin: 0 0 .5rem; color: var(--muted); }
  .dato { font-family: var(--font-bubble); font-weight: 600; color: var(--text); font-size: .95rem; }
</style>
