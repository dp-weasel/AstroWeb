---
// Lo que pasa en pantalla según lo que escribas en el chat.
// Textos en src/content/portada/comandos.yaml.
import { leer } from "../../lib/contenido";
import Ejemplo from "../ui/Ejemplo.astro";

const { comandos } = await leer("comandos");
---

<ul class="comandos">
  {comandos.map((c) => (
    <li>
      <code>{c.comando}</code>
      <span>{c.que_hace} {c.etiqueta && <Ejemplo texto={c.etiqueta} />}</span>
    </li>
  ))}
</ul>

<style>
  .comandos { list-style: none; margin: 0; padding: 0; display: grid; gap: .5rem; }
  li { display: grid; grid-template-columns: 10rem 1fr; gap: 1rem; align-items: center; padding: .7rem 1rem; border-radius: .75rem; background: var(--surface); }
  code { justify-self: start; padding: .2rem .6rem; border-radius: .4rem; background: var(--charcoal); color: var(--amber); font-family: ui-monospace, monospace; font-weight: 700; font-size: .9rem; white-space: nowrap; }
  span { color: var(--muted); }
  @media (max-width: 34rem) { li { grid-template-columns: 1fr; gap: .35rem; } }
</style>
