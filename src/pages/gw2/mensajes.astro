---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import SearchBox from "../../components/SearchBox.astro";
import Tabs from "../../components/Tabs.astro";
import Toast from "../../components/Toast.astro";
import { getCategories } from "../../lib/messages";

const categories = await getCategories();
---

<BaseLayout title="Mensajes de GW2 · Weasel Shiro" description="Mensajes de Guild Wars 2 listos para copiar con un clic y pegar en el chat del juego.">
  <Hero compact title="Mensajes de GW2" subtitle="Haz clic en un mensaje para copiarlo y pégalo en el chat de GW2." />
  <main>
    <SearchBox />
    <Tabs categories={categories} />
  </main>
  <Toast />
</BaseLayout>

<style>
  main {
    max-width: 46rem;
    margin: 0 auto;
    padding: 0 1rem 4rem;
  }
</style>
