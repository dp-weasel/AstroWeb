---
// Tierlist de profesiones y especializaciones de élite de GW2.
// Textos en src/content/gw2/pagina-tierlist.yaml.
import BaseLayout from "../../layouts/BaseLayout.astro";
import TierList from "../../components/tierlist/TierList.astro";
import Toast from "../../components/ui/Toast.astro";
import { leer } from "../../lib/contenido";

const pagina = await leer("pagina-tierlist");
---

<BaseLayout title={pagina.pestana} description={pagina.descripcion}>
  <main>
    <h1 class="titulo-marca">{pagina.titulo}</h1>
    <p class="idea">{pagina.intro}</p>
    <TierList />
  </main>
  <Toast />
</BaseLayout>

<style>
  main { max-width: 80rem; margin: 0 auto; padding: 1rem 1rem 4rem; }
  h1 { margin: 0 0 .25rem; font-size: clamp(1.6rem, 5vw, 2.4rem); }
  .idea { margin: 0 0 1.5rem; max-width: 46rem; color: var(--muted); }
</style>
