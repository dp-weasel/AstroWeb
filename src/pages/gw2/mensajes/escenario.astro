---
// Versión 3 · El escenario: la 2 llevada al estilo de la portada. Banner diagonal,
// franja de números, categorías en una columna, mensajes como bocadillos y EDM
// opinando en un escenario como el de la tierlist. Se elige el canal del chat y el
// comando (/map, /squad…) se copia delante del mensaje.
import { Image, getImage } from "astro:assets";
import "@fontsource-variable/unbounded";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import VersionesNav from "../../../components/mensajes/VersionesNav.astro";
import SearchBox from "../../../components/SearchBox.astro";
import Tabs from "../../../components/Tabs.astro";
import Toast from "../../../components/Toast.astro";
import Bocadillo from "../../../components/marca/Bocadillo.astro";
import { getCategories } from "../../../lib/messages";
import { GW2_CHAT_LIMIT } from "../../../lib/gw2";
import { frases, canales } from "../../../data/mensajes-versiones";
import { profile } from "../../../data/profile";
import "../../../styles/mensajes-marca.css";
import edmSaludando from "../../../assets/brand/edm/saludando.png";
import edmApuntando from "../../../assets/brand/edm/apuntando.png";
import edmShrug from "../../../assets/brand/edm/shrug.png";
import edmSorprendida from "../../../assets/brand/edm/sorprendida.png";
import edmHiss from "../../../assets/brand/edm/hiss.png";
import edmArriba from "../../../assets/brand/edm/feliz-apuntando-arriba.png";
import edmCheer from "../../../assets/brand/edm/cheer.png";
import edmRiendo from "../../../assets/brand/edm/riendo-en-el-suelo.png";
import edmGritando from "../../../assets/brand/edm/gritando.png";

const categories = await getCategories();
const total = categories.reduce((n, c) => n + c.messages.length, 0);

// Poses de EDM según lo que pasa. El navegador cambia la imagen con estas URLs.
const pose = async (src: ImageMetadata) => (await getImage({ src, width: 360 })).src;
const poses = {
  inicio: await pose(edmSaludando),
  "mundo-abierto": await pose(edmShrug),
  fractales: await pose(edmSorprendida),
  raids: await pose(edmHiss),
  personalizado: await pose(edmArriba),
  largo: await pose(edmGritando),
  copiado: [await pose(edmCheer), await pose(edmApuntando), await pose(edmRiendo)],
};

const numeros = [
  { valor: total, etiqueta: "Mensajes listos" },
  { valor: categories.length, etiqueta: "Categorías" },
  { valor: GW2_CHAT_LIMIT, etiqueta: "Caracteres por mensaje" },
  { valor: "1 clic", etiqueta: "Y ya está copiado" },
];
---

<BaseLayout title="Mensajes de GW2 · Weasel Shiro" description="Mensajes de Guild Wars 2 listos para copiar con un clic y pegar en el chat del juego." noindex>
  <VersionesNav slug="escenario" />
  <main class="mm v3">
    <section class="banner">
      <div class="naranja" aria-hidden="true">
        <Image src={edmApuntando} alt="" width={420} loading="eager" />
      </div>
      <div class="texto">
        <p class="eyebrow titulo-marca">Herramientas para Guild Wars 2</p>
        <h1 class="nombre">MENSAJES</h1>
        <p class="lead">
          Metas, grupos de fractales, raids: los mensajes de siempre, listos para el chat. Tocás uno, se copia, y en el
          juego lo pegás con <kbd>Ctrl</kbd>+<kbd>V</kbd>.
        </p>
        <a class="ir" href="#mensajes">Ver los mensajes ↓</a>
      </div>
    </section>

    <div class="franja">
      <dl>
        {numeros.map((n) => (
          <div><dd>{n.valor}</dd><dt>{n.etiqueta}</dt></div>
        ))}
      </dl>
    </div>

    <section class="escenario zona" id="mensajes" aria-label="Mensajes">
      <SearchBox />
      <Tabs categories={categories} conteo />

      <aside class="edm-lado" aria-label="EDM opina">
        <Bocadillo quien="edm" cola="abajo"><p data-dice aria-live="polite">{frases.edm.inicio}</p></Bocadillo>
        <img class="pose" data-pose src={poses.inicio} alt="EDM" width="180" height="240" />
        <data id="poses" value={JSON.stringify(poses)} hidden></data>

        <fieldset class="canal">
          <legend>Canal del chat</legend>
          <div class="opciones">
            {canales.map((c, i) => (
              <label style={`--c: ${c.color}`}>
                <input type="radio" name="canal" value={c.id} checked={i === 0} />
                <span>{c.nombre}</span>
              </label>
            ))}
          </div>
          <p class="nota">Con un canal elegido, el mensaje se copia con su comando adelante (por ejemplo <code>/map</code>).</p>
        </fieldset>

        <figure class="chat">
          <figcaption>Así se va a ver en el chat</figcaption>
          <p class="linea" data-vista>
            <span class="tag" data-vista-canal></span>
            <span class="autor">{profile.name}:</span>
            <span data-vista-texto class="vacio">Tocá un mensaje para verlo acá.</span>
          </p>
        </figure>
      </aside>
    </section>
  </main>
  <Toast />
</BaseLayout>

<style>
  .v3 { max-width: none; padding: 0 0 4rem; }

  /* ---------- Banner (como la portada, más bajo) ---------- */
  .banner {
    position: relative; display: grid; grid-template-columns: 38% 1fr; align-items: center;
    min-height: 22rem; background: #212121; color: var(--snow); overflow: hidden; isolation: isolate;
  }
  .naranja {
    align-self: stretch; display: grid; place-items: end center;
    background: linear-gradient(135deg, var(--vermilion), var(--amber));
    clip-path: polygon(0 0, 100% 0, 80% 100%, 0 100%);
  }
  .naranja img { width: min(15rem, 70%); height: auto; margin-bottom: -1rem; filter: drop-shadow(0 .6rem 1rem rgb(0 0 0 / .4)); }
  .texto { padding: 2.5rem 2rem 3.5rem 0; max-width: 36rem; }
  .eyebrow { margin: 0 0 .5rem; color: var(--amber); font-size: .9rem; }
  .nombre {
    margin: 0 0 1rem; line-height: .95; color: var(--snow);
    font-family: "Unbounded Variable", sans-serif; font-weight: 900; letter-spacing: -.03em;
    font-size: clamp(2.4rem, 7vw, 4.25rem);
  }
  .nombre::after { content: ""; display: block; width: 1.4em; height: .12em; margin-top: .12em; background: var(--amber); transform: skewX(-25deg); }
  .lead { margin: 0 0 1.25rem; color: #cfcfcf; font-size: 1.05rem; font-weight: 500; }
  .lead kbd { background: #2b2b2b; color: var(--snow); border-color: #555; }
  .ir {
    display: inline-flex; align-items: center; height: 3rem; padding: 0 1.5rem; border-radius: .75rem;
    background: linear-gradient(135deg, var(--vermilion), var(--amber)); color: #fff; text-decoration: none;
    font: italic 800 1rem var(--font-text); text-transform: uppercase; letter-spacing: .02em;
    transition: transform .15s;
  }
  .ir:hover { transform: translateY(-2px); }

  /* ---------- Franja ---------- */
  .franja {
    margin-top: -2rem; position: relative; z-index: 2;
    padding: 1.5rem max(1rem, calc((100vw - 60rem) / 2)) 1.25rem;
    background: linear-gradient(135deg, var(--vermilion), var(--amber));
    clip-path: polygon(0 1.5rem, 100% 0, 100% calc(100% - 1.5rem), 0 100%);
    color: var(--charcoal); text-align: center;
  }
  .franja dl { margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: .5rem; }
  .franja div { padding: .75rem .5rem; }
  .franja dd { margin: 0; font-family: var(--font-brand); font-size: clamp(2rem, 5vw, 3rem); line-height: 1; font-variant-numeric: tabular-nums; }
  .franja dt { margin-top: .35rem; font-family: var(--font-title); font-weight: 900; font-style: italic; text-transform: uppercase; font-size: .8rem; color: rgb(33 33 33 / .75); }

  /* ---------- Escenario: categorías | mensajes | EDM ---------- */
  .mm .escenario.zona {
    max-width: 82rem; margin: 3.5rem auto 0; padding: 0 1rem;
    grid-template-columns: 15rem minmax(0, 1fr) 19rem; grid-template-rows: auto 1fr; gap: 1rem 1.75rem;
    scroll-margin-top: 1rem;
  }
  .escenario > :global(.search) { grid-column: 1; grid-row: 1; }
  .escenario :global(.tabs) {
    grid-column: 1; grid-row: 2; align-self: start; position: sticky; top: 1rem;
    flex-direction: column; flex-wrap: nowrap; align-items: stretch; margin: 0 !important;
  }
  .escenario :global([role="tabpanel"]) { grid-column: 2 !important; grid-row: 1 / span 2; align-self: start; }
  .escenario :global(.storage-note) { grid-column: 2 !important; margin-top: 0; }
  .edm-lado { grid-column: 3; grid-row: 1 / span 2; }

  /* Categorías como fichas, con ícono. */
  .escenario :global(.tab) {
    display: grid !important; grid-template-columns: 2.25rem 1fr; grid-template-rows: auto auto;
    justify-items: start !important; align-items: center; column-gap: .6rem; text-align: left;
    padding: .7rem .9rem !important; font-size: 1.15rem !important;
  }
  .escenario :global(.tab)::before {
    grid-row: 1 / span 2; display: grid; place-items: center; width: 2.25rem; height: 2.25rem;
    border-radius: .6rem; background: var(--bg); font-size: 1.25rem; content: "💬";
  }
  .escenario :global(.tab[data-tab-id="mundo-abierto"])::before { content: "🗺️"; }
  .escenario :global(.tab[data-tab-id="fractales"])::before { content: "🌀"; }
  .escenario :global(.tab[data-tab-id="raids"])::before { content: "🐉"; }
  .escenario :global(.tab[data-tab-id="personalizado"])::before { content: "✏️"; }
  .escenario :global(.tab[aria-selected="true"])::before { background: rgb(0 0 0 / .15); }
  .escenario :global(.tab-count) { position: absolute; top: .5rem; right: .5rem; margin: 0 !important; transform: none !important; }

  /* Mensajes como bocadillos crema, igual que los de la portada. */
  .escenario :global(.messages .card) {
    background: var(--cream) !important; color: var(--charcoal);
    border: 3px solid var(--charcoal) !important; border-radius: 1.25rem !important;
    box-shadow: .35rem .35rem 0 var(--amber);
  }
  .escenario :global(.messages .card:has(.copy:hover)) { box-shadow: .55rem .55rem 0 var(--amber) !important; }
  .escenario :global(.messages [data-origin="edited"] .card),
  .escenario :global(.messages [data-origin="custom"] .card) { box-shadow: .35rem .35rem 0 var(--magenta); }
  .escenario :global(.messages .copy) { font-family: var(--font-bubble) !important; font-weight: 600 !important; font-size: 1.05rem; }
  .escenario :global(.messages .meta) { color: #6b6257; }
  .escenario :global(.messages .actions) { border-left: 2px dashed rgb(33 33 33 / .25); }
  .escenario :global(.messages .action) { color: #6b6257; }
  .escenario :global(.messages .action:hover) { background: rgb(0 0 0 / .07); color: var(--vermilion); }
  .escenario :global(.messages .text mark) { background: var(--amber); }

  /* ---------- EDM ---------- */
  .edm-lado {
    position: sticky; top: 1rem; align-self: start; display: grid; justify-items: center; gap: .9rem;
    padding: 1.25rem 1rem 1rem; border-radius: 1.25rem;
    background: radial-gradient(circle at 50% 35%, rgb(214 36 159 / .18), transparent 65%), var(--surface);
  }
  .edm-lado :global(.bocadillo) { width: 100%; min-height: 6.5rem; }
  .pose { width: 10rem; height: 13rem; object-fit: contain; object-position: bottom; transition: transform .2s; }
  .pose.salta { animation: salta .4s cubic-bezier(.3, 1.6, .5, 1); }
  @keyframes salta { from { transform: translateY(.75rem) scale(.95); } }

  .canal { width: 100%; margin: 0; padding: 0; border: 0; }
  legend { margin-bottom: .4rem; font: 400 1rem var(--font-label); letter-spacing: .03em; }
  .opciones { display: flex; flex-wrap: wrap; gap: .35rem; }
  .opciones label { position: relative; cursor: pointer; }
  .opciones input { position: absolute; opacity: 0; }
  .opciones span {
    display: inline-block; padding: .25rem .6rem; border: 2px solid var(--border); border-radius: .5rem;
    font-size: .82rem; font-weight: 700; color: var(--muted);
  }
  .opciones span::before { content: ""; display: inline-block; width: .55rem; height: .55rem; margin-right: .35rem; border-radius: 50%; background: var(--c); box-shadow: 0 0 0 1px rgb(0 0 0 / .4); }
  .opciones input:checked + span { border-color: var(--amber); color: var(--text); background: var(--bg); }
  .opciones input:focus-visible + span { outline: 2px solid var(--amber); outline-offset: 2px; }
  .nota { margin: .45rem 0 0; color: var(--muted); font-size: .78rem; }
  code { font-size: .9em; }

  .chat {
    width: 100%; margin: 0; padding: .7rem .85rem .9rem; border-radius: .6rem;
    background: rgb(10 10 12 / .88); border: 1px solid #000; box-shadow: inset 0 0 0 1px rgb(255 255 255 / .06);
    color: var(--canal, #f2f2f2); font: 500 .88rem/1.45 var(--font-body);
  }
  figcaption { margin-bottom: .35rem; color: #8a8a8a; font: 700 .68rem var(--font-body); text-transform: uppercase; letter-spacing: .08em; }
  .linea { margin: 0; overflow-wrap: anywhere; text-shadow: 0 1px 1px #000; }
  .tag:empty { display: none; }
  .tag, .autor { margin-right: .3em; }
  .autor { color: #ffb347; font-weight: 700; }
  .vacio { color: #777; font-style: italic; }
  :global(.cortado) { color: #777; text-decoration: line-through; }

  @media (max-width: 66rem) {
    .mm .escenario.zona { grid-template-columns: 13rem minmax(0, 1fr); }
    .edm-lado { grid-column: 1 / -1; grid-row: auto; position: static; grid-template-columns: auto 1fr; justify-items: stretch; align-items: center; }
    .edm-lado :global(.bocadillo) { grid-column: 2; grid-row: 1; }
    .pose { grid-column: 1; grid-row: 1 / span 2; width: 7rem; height: 9rem; }
    .canal, .chat { grid-column: 2; }
  }
  @media (max-width: 44rem) {
    .banner { grid-template-columns: 1fr; min-height: 0; }
    .naranja { height: 11rem; clip-path: polygon(0 0, 100% 0, 100% 75%, 0 100%); }
    .naranja img { width: 8rem; }
    .texto { padding: 1.25rem 1rem 3rem; }
    .mm .escenario.zona { grid-template-columns: 1fr; margin-top: 2rem; }
    /* En el celular, una columna: buscador, categorías, EDM chiquita y los mensajes. */
    .escenario > :global(.search),
    .escenario :global(.tabs),
    .escenario :global([role="tabpanel"]),
    .escenario :global(.storage-note),
    .edm-lado { grid-column: 1 !important; grid-row: auto; }
    .escenario > :global(.search) { order: 1; }
    .escenario :global(.tabs) { order: 2; position: static; display: grid; grid-template-columns: 1fr 1fr; gap: .5rem; }
    .edm-lado { order: 3; }
    .escenario :global([role="tabpanel"]) { order: 4; }
    .escenario :global(.storage-note) { order: 5; }
    .escenario :global(.tab) { font-size: 1rem !important; padding: .55rem .7rem !important; }
    .edm-lado { grid-template-columns: 4.5rem 1fr; padding: .75rem; gap: .6rem .75rem; }
    .pose { width: 4.5rem; height: 6rem; grid-row: 1; }
    .edm-lado :global(.bocadillo) { min-height: 0; font-size: .95rem; }
    .canal { grid-column: 1 / -1; }
    .chat { display: none; }
  }
</style>

<script>
  import { frases, canales } from "../../../data/mensajes-versiones";
  import { GW2_CHAT_LIMIT } from "../../../lib/gw2";

  type Poses = Record<string, string> & { copiado: string[] };
  const poses = JSON.parse((document.getElementById("poses") as HTMLDataElement).value) as unknown as Poses;
  const dice = document.querySelector<HTMLElement>("[data-dice]")!;
  const pose = document.querySelector<HTMLImageElement>("[data-pose]")!;
  const vista = document.querySelector<HTMLElement>("[data-vista-texto]")!;
  const vistaCanal = document.querySelector<HTMLElement>("[data-vista-canal]")!;
  const chat = document.querySelector<HTMLElement>(".chat")!;
  const quieto = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Precarga las poses para que el cambio sea instantáneo.
  for (const v of Object.values(poses).flat()) new Image().src = v;

  let ultima = -1;
  const alAzar = <T,>(lista: T[]) => {
    let i = Math.floor(Math.random() * lista.length);
    if (lista.length > 1 && i === ultima) i = (i + 1) % lista.length;
    ultima = i;
    return { item: lista[i], i };
  };
  const decir = (texto: string, src: string) => {
    dice.textContent = texto;
    if (pose.src !== new URL(src, location.href).href) pose.src = src;
    if (!quieto) {
      pose.classList.remove("salta");
      void pose.offsetWidth;
      pose.classList.add("salta");
    }
  };

  // Canal elegido: el comando se agrega justo antes de copiar (captura, antes que clipboard.ts).
  const canalActual = () => {
    const id = document.querySelector<HTMLInputElement>('input[name="canal"]:checked')?.value ?? "";
    return canales.find((c) => c.id === id) ?? canales[0];
  };
  const pintarCanal = () => {
    const c = canalActual();
    vistaCanal.textContent = c.etiqueta;
    chat.style.setProperty("--canal", c.color);
  };
  document.querySelectorAll('input[name="canal"]').forEach((r) => r.addEventListener("change", pintarCanal));
  pintarCanal();

  document.addEventListener(
    "click",
    (e) => {
      const btn = (e.target as Element).closest<HTMLElement>("[data-copy]");
      const li = btn?.closest<HTMLElement>("[data-message]");
      if (!btn || !li) return;
      btn.dataset.copy = canalActual().comando + (li.dataset.text ?? "");
    },
    { capture: true },
  );

  document.addEventListener("mensaje:copiado", (e) => {
    const c = canalActual();
    const texto = (e as CustomEvent<{ texto: string }>).detail.texto.slice(c.comando.length);
    const pasado = texto.length > GW2_CHAT_LIMIT;
    vista.classList.remove("vacio");
    vista.textContent = texto.slice(0, GW2_CHAT_LIMIT);
    if (pasado) {
      const resto = document.createElement("span");
      resto.className = "cortado";
      resto.textContent = texto.slice(GW2_CHAT_LIMIT);
      vista.append(resto);
      decir(frases.edm.largo, poses.largo);
      return;
    }
    const frase = alAzar(frases.edm.copiado).item;
    decir(frase, poses.copiado[Math.floor(Math.random() * poses.copiado.length)]);
  });

  // Al cambiar de categoría, EDM opina y cambia de pose.
  document.querySelectorAll<HTMLElement>('[role="tab"]').forEach((tab) =>
    tab.addEventListener("click", () => {
      const id = tab.dataset.tabId!;
      const t = frases.edm.categorias[id];
      if (t) decir(t, poses[id] ?? poses.inicio);
    }),
  );
</script>
