---
// Versión 2 · Con el Armiño: la 1, más el Armiño al costado. Explica cómo se usa,
// habla cuando copiás y muestra cómo se va a ver el mensaje en el chat del juego.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import VersionesNav from "../../../components/mensajes/VersionesNav.astro";
import SearchBox from "../../../components/SearchBox.astro";
import Tabs from "../../../components/Tabs.astro";
import Toast from "../../../components/Toast.astro";
import ArminoVivo from "../../../components/marca/ArminoVivo.astro";
import Bocadillo from "../../../components/marca/Bocadillo.astro";
import { getCategories } from "../../../lib/messages";
import { frases } from "../../../data/mensajes-versiones";
import { profile } from "../../../data/profile";
import "../../../styles/mensajes-marca.css";

const categories = await getCategories();
---

<BaseLayout title="Mensajes de GW2 · Weasel Shiro" description="Mensajes de Guild Wars 2 listos para copiar con un clic y pegar en el chat del juego." noindex>
  <VersionesNav slug="armino" />
  <main class="mm">
    <h1 class="titulo-marca">Mensajes de GW2</h1>
    <p class="idea">
      Mensajes listos para el chat del juego: metas, grupos de fractales, raids. Tocá uno y se copia. Podés editarlos o
      agregar los tuyos, y se guardan solos en tu navegador.
    </p>

    <div class="columnas">
      <div class="zona">
        <SearchBox />
        <Tabs categories={categories} conteo />
      </div>

      <aside class="ayudante" aria-label="El Armiño te ayuda">
        <div class="quien">
          <ArminoVivo size="11rem" id="armino-ayuda" />
          <Bocadillo quien="armino" cola="abajo"><p data-dice aria-live="polite">{frases.armino.inicio}</p></Bocadillo>
        </div>
        <figure class="chat">
          <figcaption>Así se va a ver en el chat</figcaption>
          <p class="linea" data-vista>
            <span class="nombre">{profile.name}:</span>
            <span data-vista-texto class="vacio">Tocá un mensaje para verlo acá.</span>
          </p>
          <p class="largo" data-vista-largo hidden>
            Se corta acá ↑ (el chat admite 199 caracteres)
          </p>
        </figure>
        <ol class="pasos">
          <li><b>1</b> Tocá el mensaje</li>
          <li><b>2</b> En el juego: <kbd>Enter</kbd></li>
          <li><b>3</b> <kbd>Ctrl</kbd>+<kbd>V</kbd> y <kbd>Enter</kbd></li>
        </ol>
      </aside>
    </div>
  </main>
  <Toast />
</BaseLayout>

<style>
  main { max-width: 72rem; margin: 0 auto; padding: 1rem 1rem 4rem; }
  h1 { margin: 0 0 .25rem; font-size: clamp(1.6rem, 5vw, 2.4rem); }
  .idea { margin: 0 0 1.5rem; max-width: 46rem; color: var(--muted); }

  .columnas { display: grid; grid-template-columns: minmax(0, 1fr) 19rem; gap: 2rem; align-items: start; }
  /* En esta versión las pestañas van debajo del buscador, a lo ancho. */
  .columnas .zona { grid-template-columns: 1fr; }
  .columnas .zona :global(.search) { margin-bottom: 1rem; }
  .columnas .zona :global(.tabs) { justify-content: flex-start; }

  .ayudante { position: sticky; top: 1rem; display: grid; gap: 1.25rem; }
  .quien { display: flex; flex-direction: column-reverse; align-items: center; gap: 0; }
  .quien :global(.armino-vivo) { margin-top: -1.5rem; }
  .quien :global(.bocadillo) { width: 100%; }

  /* Vista previa con el aspecto del chat del juego. */
  .chat {
    margin: 0; padding: .75rem .9rem 1rem; border-radius: .6rem;
    background: rgb(10 10 12 / .85); border: 1px solid #000; box-shadow: inset 0 0 0 1px rgb(255 255 255 / .06);
    color: #e8d5a6; font: 500 .9rem/1.45 var(--font-body);
  }
  figcaption { margin-bottom: .4rem; color: #8a8a8a; font: 700 .7rem var(--font-body); text-transform: uppercase; letter-spacing: .08em; }
  .linea { margin: 0; overflow-wrap: anywhere; text-shadow: 0 1px 1px #000; }
  .nombre { margin-right: .3em; color: #ffb347; font-weight: 700; }
  .vacio { color: #777; font-style: italic; }
  .largo { margin: .4rem 0 0; color: #ff7a5c; font-size: .8rem; font-weight: 700; }
  :global(.cortado) { color: #777; text-decoration: line-through; }

  .ayudante .pasos { flex-direction: column; gap: .4rem; margin: 0; }

  @media (max-width: 56rem) {
    .columnas { grid-template-columns: 1fr; }
    /* En el celular el Armiño va arriba, chico y al lado del bocadillo. */
    .ayudante { grid-row: 1; position: static; }
    .quien { flex-direction: row; align-items: center; gap: 1rem; }
    .quien :global(.armino-vivo) { margin-top: 0; }
    .quien :global(.armino-vivo) { --size: 5rem !important; flex: none; }
    .quien :global(.bocadillo::after) { left: -.62rem; top: 1.6rem; bottom: auto; transform: rotate(45deg); }
    .chat, .ayudante .pasos { display: none; }
  }
</style>

<script>
  import { frases } from "../../../data/mensajes-versiones";
  import { GW2_CHAT_LIMIT } from "../../../lib/gw2";

  const armino = document.getElementById("armino-ayuda")!;
  const dice = document.querySelector<HTMLElement>("[data-dice]")!;
  const vista = document.querySelector<HTMLElement>("[data-vista-texto]")!;
  const largo = document.querySelector<HTMLElement>("[data-vista-largo]")!;
  let ultima = -1;

  const hablar = (texto: string, ms = 1400) => {
    dice.textContent = texto;
    armino.dataset.hablando = "true";
    setTimeout(() => (armino.dataset.hablando = "false"), ms);
  };
  const alAzar = (lista: string[]) => {
    let i = Math.floor(Math.random() * lista.length);
    if (i === ultima) i = (i + 1) % lista.length;
    ultima = i;
    return lista[i];
  };

  document.addEventListener("mensaje:copiado", (e) => {
    const { texto } = (e as CustomEvent<{ texto: string }>).detail;
    const pasado = texto.length > GW2_CHAT_LIMIT;
    vista.classList.remove("vacio");
    vista.textContent = texto.slice(0, GW2_CHAT_LIMIT);
    if (pasado) {
      const resto = document.createElement("span");
      resto.className = "cortado";
      resto.textContent = texto.slice(GW2_CHAT_LIMIT);
      vista.append(resto);
    }
    largo.hidden = !pasado;
    hablar(pasado ? frases.armino.largo : alAzar(frases.armino.copiado), pasado ? 2200 : 1400);
  });

  // Al cambiar de pestaña, el Armiño comenta la categoría.
  document.querySelectorAll<HTMLElement>('[role="tab"]').forEach((tab) =>
    tab.addEventListener("click", () => {
      const t = frases.armino.categorias[tab.dataset.tabId!];
      if (t) hablar(t, 1100);
    }),
  );

  // Saluda al entrar.
  setTimeout(() => hablar(frases.armino.inicio, 1600), 500);
</script>
