---
// Una página por versión de la tierlist. Las versiones se suman: cada una tiene
// todo lo de la anterior (ver src/data/tierlist.ts). Mientras se elige, no se indexan.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TierList, { type Opciones } from "../../../components/tierlist/TierList.astro";
import VersionesNav from "../../../components/tierlist/VersionesNav.astro";
import Toast from "../../../components/Toast.astro";
import { versiones } from "../../../data/tierlist";

const opcionesPorVersion: Record<string, Opciones> = {
  simple: {},
  configurable: { editarFilas: true, filtros: true },
  compartir: { editarFilas: true, filtros: true, encabezado: true, exportar: true },
  directo: { editarFilas: true, filtros: true, encabezado: true, exportar: true, directo: true },
};

export function getStaticPaths() {
  return versiones.map((v) => ({ params: { version: v.slug } }));
}

const v = versiones.find((x) => x.slug === Astro.params.version)!;
const opciones = opcionesPorVersion[v.slug];
---

<BaseLayout title={`Tierlist de GW2 · ${v.nombre}`} description="Armá tu tierlist de profesiones y especializaciones de élite de Guild Wars 2." noindex>
  <main class:list={{ ancho: opciones.directo }}>
    <VersionesNav slug={v.slug} />
    <h1 class="titulo-marca">Tierlist de GW2</h1>
    <p class="idea">{v.idea}</p>
    <TierList opciones={opciones} />
  </main>
  <Toast />
</BaseLayout>

<style>
  main { max-width: 64rem; margin: 0 auto; padding: 1rem 1rem 4rem; }
  main.ancho { max-width: 80rem; }
  h1 { margin: 0 0 .25rem; font-size: clamp(1.6rem, 5vw, 2.4rem); }
  .idea { margin: 0 0 1.5rem; color: var(--muted); }
</style>
