---
// Portada: banner diagonal, charla entre el Armiño y EDM, equipo, historia,
// stickers, comandos, metas, videos, reglas, herramientas, apoyo y preguntas.
// Todos los textos están en src/content/portada/ (un YAML por sección; ver
// src/content/LEEME.md). Lo que falta definir lleva una `etiqueta` (EJEMPLO,
// Idea…) en su YAML (ver todo.md).
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import "@fontsource-variable/unbounded";
import ArminoVivo from "../components/marca/ArminoVivo.astro";
import Bocadillo from "../components/marca/Bocadillo.astro";
import Ctas from "../components/marca/Ctas.astro";
import Numeros from "../components/portada/Numeros.astro";
import Presenta from "../components/portada/Presenta.astro";
import Personajes from "../components/portada/Personajes.astro";
import SobreMi from "../components/portada/SobreMi.astro";
import Emotes from "../components/portada/Emotes.astro";
import Comandos from "../components/portada/Comandos.astro";
import Metas from "../components/portada/Metas.astro";
import Videos from "../components/portada/Videos.astro";
import Reglas from "../components/portada/Reglas.astro";
import Apoyar from "../components/portada/Apoyar.astro";
import Ejemplo from "../components/ui/Ejemplo.astro";
import armino from "../assets/brand/weasel-mouth-closed-headphones.png";
import edmApuntando from "../assets/brand/edm/apuntando.png";
import { leer, conNegritas } from "../lib/contenido";
import { imagenEdm } from "../lib/imagenes";
import { ruta } from "../lib/rutas";
import { descripcionPose } from "../lib/edm";

const banner = await leer("banner");
const canal = await leer("como-es-el-canal");
const equipo = await leer("equipo");
const historia = await leer("historia");
const stickers = await leer("stickers");
const comandos = await leer("comandos");
const metas = await leer("metas");
const videos = await leer("videos");
const reglas = await leer("reglas");
const herramientas = await leer("herramientas");
const apoyar = await leer("apoyar");
const preguntas = await leer("preguntas");
const despedida = await leer("despedida");
---

<BaseLayout title={banner.pestana} description={banner.descripcion}>
  <main data-escena>
    <!-- 1. Banner (de la variante 2) -->
    <!-- Logo actual con auriculares. Pendiente: reemplazarlo por un logo nuevo
         en el estilo del pngTuber (ver todo.md). <ArminoVivo auriculares /> sirve
         de referencia de cómo quedaría. -->
    <section class="banner">
      <div class="naranja" aria-hidden="true">
        <Image src={armino} alt="" width={640} widths={[320, 480, 640]} sizes="(max-width: 48rem) 70vw, 34vw" loading="eager" />
      </div>
      <div class="marca-agua" aria-hidden="true">
        <Image src={armino} alt="" width={640} widths={[320, 640]} sizes="40vw" />
      </div>
      <div class="texto">
        <p class="eyebrow titulo-marca">{banner.antetitulo}</p>
        <h1 class="nombre">{banner.nombre}</h1>
        <p class="lead">{banner.intro}</p>
        <Ctas />
      </div>
    </section>

    <!-- Franja debajo del banner (de la variante 2) -->
    <div class="franja"><Numeros /></div>

    <!-- 2. Cómo es el canal, charlado (de la 5) -->
    <section class="charla" aria-labelledby="valores">
      <h2 id="valores" class="titulo-marca">{canal.titulo}</h2>
      {canal.charla.map((t) =>
        t.quien === "armino" ? (
          <div class="turno aparece">
            <ArminoVivo size="7rem" class="avatar" />
            <Bocadillo quien="armino"><p set:html={conNegritas(t.texto)} /></Bocadillo>
          </div>
        ) : (
          <div class="turno edm aparece">
            <Bocadillo quien="edm" cola="derecha"><p set:html={conNegritas(t.texto)} /></Bocadillo>
            <Image class="avatar" src={imagenEdm(t.pose)} alt={descripcionPose[t.pose]} width={200} />
          </div>
        ),
      )}
    </section>

    <!-- 3. Equipo e historia (de la 4), presentados por el Armiño -->
    <section class="bloque" aria-labelledby="equipo">
      <h2 id="equipo" class="titulo-marca">{equipo.titulo}</h2>
      <Presenta {...equipo.presenta} />
      <Personajes />
    </section>

    <section class="bloque" aria-labelledby="historia">
      <h2 id="historia" class="titulo-marca">{historia.titulo}</h2>
      <Presenta {...historia.presenta} />
      <SobreMi />
    </section>

    <!-- 4. Stickers y chat, presentados por EDM -->
    <section class="bloque" aria-labelledby="emotes">
      <h2 id="emotes" class="titulo-marca">{stickers.titulo}</h2>
      <Presenta {...stickers.presenta} />
      <Emotes />
      <ol class="uso">
        {stickers.usos.map((u, i) => (
          <li>
            <span class="paso">{i + 1}</span>
            <strong>{u.cuando}</strong>
            <p>{u.texto}</p>
            {u.etiqueta && <Ejemplo texto={u.etiqueta} />}
          </li>
        ))}
      </ol>
    </section>

    <section class="bloque angosto" aria-labelledby="comandos">
      <h2 id="comandos" class="titulo-marca">{comandos.titulo}</h2>
      <Presenta {...comandos.presenta} />
      <Comandos />
    </section>

    <section class="bloque angosto" aria-labelledby="metas">
      <h2 id="metas" class="titulo-marca">{metas.titulo}</h2>
      <Presenta {...metas.presenta} />
      <Metas />
    </section>

    <section class="bloque" aria-labelledby="videos">
      <h2 id="videos" class="titulo-marca">{videos.titulo}</h2>
      <Videos />
    </section>

    <section class="bloque angosto" aria-labelledby="reglas">
      <h2 id="reglas" class="titulo-marca">{reglas.titulo}</h2>
      <Presenta {...reglas.presenta} />
      <Reglas />
    </section>

    <!-- 5. Herramientas: EDM señala las tarjetas -->
    <section class="bloque angosto" aria-labelledby="herramientas">
      <h2 id="herramientas" class="titulo-marca">{herramientas.titulo}</h2>
      <div class="señala aparece">
        <div class="tarjetas">
          {herramientas.herramientas.map((h) => (
            <a class="tool-card" href={ruta(h.url)}>
              <span class="emoji" aria-hidden="true">{h.emoji}</span>
              <span><strong>{h.titulo} →</strong><br />{h.texto}</span>
            </a>
          ))}
        </div>
        <Image class="edm-apunta" src={edmApuntando} alt="EDM señalando las herramientas" width={240} />
      </div>
    </section>

    <section class="bloque" aria-labelledby="apoyar">
      <h2 id="apoyar" class="titulo-marca">{apoyar.titulo}</h2>
      <Presenta {...apoyar.presenta} />
      <Apoyar />
    </section>

    <!-- 6. Preguntas frecuentes (de la 2) -->
    <section class="bloque angosto" aria-labelledby="faq">
      <h2 id="faq" class="titulo-marca">{preguntas.titulo}</h2>
      <div class="faq">
        {preguntas.preguntas.map((p, i) => (
          <details open={i === 0}>
            <summary>{p.pregunta}</summary>
            <p>{p.respuesta}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- 7. Cierre: EDM -->
    <section class="cierre aparece">
      <Image src={imagenEdm(despedida.edm.pose)} alt={descripcionPose[despedida.edm.pose]} width={260} />
      <Bocadillo quien="edm" cola="izquierda"><p>{despedida.edm.texto}</p></Bocadillo>
    </section>

    <!-- El Armiño se asoma desde la línea del pie al llegar al final (de la 4) -->
    <div class="asomo" aria-hidden="true">
      <Bocadillo quien="armino" cola="derecha" class="chau"><p>{despedida.armino_al_final}</p></Bocadillo>
      <div class="ventanita"><ArminoVivo size="9rem" class="armino-chau" /></div>
    </div>
  </main>
</BaseLayout>

<style>
  main { font-family: var(--font-text); overflow-x: clip; }
  h2 { text-align: center; font-size: clamp(1.5rem, 4vw, 2rem); margin: 0 0 2rem; }

  /* ---------- Banner (siempre oscuro, como el de Twitch) ---------- */
  .banner {
    position: relative; isolation: isolate; overflow: hidden;
    display: grid; grid-template-columns: 40% 1fr; align-items: center;
    min-height: min(34rem, 80vh);
    background: var(--charcoal); color: var(--snow);
  }
  .naranja {
    align-self: stretch;
    display: grid; place-items: end center;
    background: linear-gradient(160deg, var(--amber) 55%, var(--vermilion));
    clip-path: polygon(0 0, 100% 0, 78% 100%, 0 100%);
  }
  .naranja img { width: min(80%, 26rem); height: auto; margin-right: 18%; filter: drop-shadow(0 .5rem 0 rgb(0 0 0 / .2)); }
  .marca-agua :global(img) { display: block; width: 100%; height: auto; }
  .marca-agua {
    position: absolute; z-index: -1; right: -6%; top: 50%;
    width: min(42rem, 55vw); height: auto;
    transform: translateY(-50%) scaleX(-1);
    filter: grayscale(1) brightness(.6); opacity: .12;
  }
  .texto { padding: 3rem 2rem 3rem 0; max-width: 34rem; }
  .eyebrow { margin: 0 0 .5rem; color: var(--amber); font-size: .9rem; }
  /* Nombre: Unbounded en blanco, con un subrayado naranja inclinado. */
  .nombre {
    margin: 0 0 1rem; line-height: .95; color: var(--snow);
    font-family: "Unbounded Variable", sans-serif; font-weight: 900; letter-spacing: -.03em;
    font-size: calc(clamp(3rem, 9vw, 6rem) * .8);
  }
  .nombre::after { content: ""; display: block; width: 1.4em; height: .12em; margin-top: .12em; background: var(--amber); transform: skewX(-25deg); }


  /* Franja: naranja inclinada debajo del banner, como en la variante 2. */
  .franja {
    margin-top: -2.5rem; position: relative; z-index: 2;
    padding: 1.5rem max(1rem, calc((100vw - 60rem) / 2)) 1rem;
    background: linear-gradient(135deg, var(--vermilion), var(--amber));
    clip-path: polygon(0 1.5rem, 100% 0, 100% calc(100% - 1.5rem), 0 100%);
    color: var(--charcoal);
  }
  .franja :global(dd) { color: var(--charcoal); }
  .franja :global(dt), .franja :global(.ejemplo) { color: rgb(33 33 33 / .75); }
  .lead { margin: 0 0 1.5rem; color: #cfcfcf; font-size: 1.1rem; font-weight: 500; }
  .banner :global(.btn:not(.primary):not(.youtube)) { background: #2b2b2b; border-color: #3d3d3d; color: var(--brand, var(--snow)); }
  .banner :global(.btn[aria-label^="X"]) { color: var(--snow); }

  /* ---------- Charla ---------- */
  .charla { max-width: 46rem; margin: 5rem auto 0; padding: 0 1rem; display: grid; gap: 1.5rem; }
  .turno { display: flex; align-items: center; gap: 1rem; }
  .turno.edm { justify-content: flex-end; }
  .turno :global(.bocadillo) { flex: 0 1 30rem; }
  .turno :global(.avatar) { flex: none; }
  .turno :global(img.avatar) { width: 6.5rem; height: auto; }

  /* ---------- Secciones ---------- */
  .bloque { max-width: 60rem; margin: 5rem auto 0; padding: 0 1rem; }
  .bloque.angosto { max-width: 46rem; }

  /* Cómo se usan los stickers: tres pasos */
  .uso { list-style: none; margin: 1.5rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: .75rem; }
  .uso li { position: relative; padding: 1rem 1rem 1rem 3.5rem; border-radius: 1rem; border: 2px dashed var(--border); }
  .uso li:last-child { border-color: var(--magenta); }
  .paso {
    position: absolute; left: .9rem; top: 1rem;
    display: grid; place-items: center; width: 1.9rem; height: 1.9rem; border-radius: 50%;
    background: var(--magenta); color: #fff; font-family: var(--font-label); font-size: 1rem;
  }
  .uso p { margin: .2rem 0 .5rem; color: var(--muted); font-size: .92rem; }

  /* Herramientas */
  .señala { position: relative; padding-right: 7rem; }
  .tarjetas { display: grid; gap: .75rem; }
  .tool-card {
    display: flex; gap: 1rem; align-items: center; padding: 1.25rem;
    border: 3px solid var(--charcoal); border-radius: 1.25rem; background: var(--cream);
    color: var(--charcoal); text-decoration: none; box-shadow: .35rem .35rem 0 var(--amber);
    transition: transform .15s, box-shadow .15s;
  }
  .tool-card:hover { transform: translate(-.15rem, -.15rem); box-shadow: .5rem .5rem 0 var(--amber); }
  .tool-card .emoji { font-size: 2rem; }
  .tool-card strong { font-size: 1.1rem; }
  .edm-apunta { position: absolute; right: -1rem; top: 50%; width: 8rem; height: auto; transform: translateY(-45%); }

  /* Preguntas (estilo de la 2) */
  .faq { display: grid; gap: .5rem; }
  details { border-left: 4px solid var(--border); background: var(--surface); }
  details[open] { border-left-color: var(--amber); }
  summary { padding: 1rem 1.25rem; font-weight: 700; cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 1rem; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; color: var(--accent); font-size: 1.25rem; line-height: 1; }
  details[open] summary::after { content: "−"; }
  details p { margin: 0; padding: 0 1.25rem 1rem; color: var(--muted); }

  /* Cierre */
  .cierre { display: flex; align-items: center; justify-content: center; gap: 1rem; max-width: 40rem; margin: 5rem auto 0; padding: 0 1rem; }
  .cierre img { width: 9rem; height: auto; }

  /* El Armiño sale desde la línea donde empieza el pie, a la derecha. La
     ventanita recorta todo lo que queda por debajo de esa línea. */
  .asomo { display: flex; justify-content: flex-end; align-items: center; gap: .75rem; max-width: 60rem; margin: 3rem auto 0; padding: 0 1rem; }
  .ventanita { flex: none; width: 9rem; height: 8.5rem; overflow: hidden; }
  .asomo :global(.armino-chau) { transform: translateY(100%); transition: transform .6s cubic-bezier(.3, 1.4, .5, 1); }
  .asomo.visible :global(.armino-chau) { transform: translateY(4%); }
  .asomo :global(.chau) { max-width: 15rem; font-size: .95rem; opacity: 0; transform: scale(.8); transform-origin: right center; transition: opacity .3s .4s, transform .3s .4s; }
  .asomo.visible :global(.chau) { opacity: 1; transform: none; }

  /* Aparición al hacer scroll */
  /* Global: también la usan los componentes de la sección (p. ej. Presenta). */
  :global(.js .aparece) { opacity: 0; transform: translateY(1.5rem); transition: opacity .5s, transform .5s; }
  :global(.js .aparece.visible) { opacity: 1; transform: none; }

  @media (max-width: 48rem) {
    .banner { grid-template-columns: 1fr; }
    .naranja { height: 15rem; clip-path: polygon(0 0, 100% 0, 100% 75%, 0 100%); }
    .naranja img { width: 13rem; margin: 0; }
      .texto { padding: 1.5rem 1rem 3rem; }
    .marca-agua { width: 90vw; top: 70%; }
  }
  @media (max-width: 44rem) {
    .turno :global(.avatar) { width: 4.5rem !important; }
    .señala { padding-right: 4.5rem; }
    .edm-apunta { width: 6rem; }
    .ventanita { width: 7rem; height: 6.6rem; }
    .asomo :global(.armino-chau) { width: 7rem !important; }
    .asomo :global(.chau) { max-width: 12rem; font-size: .85rem; }
  }
</style>

<script>
  const quieto = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Las cosas aparecen al entrar en pantalla.
  if (!quieto && "IntersectionObserver" in window) {
    document.documentElement.classList.add("js");
    const io = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (!e.isIntersecting) continue;
          e.target.classList.add("visible");
          io.unobserve(e.target);
        }
      },
      { threshold: 0.3 },
    );
    document.querySelectorAll(".aparece").forEach((el) => io.observe(el));

    // Cada Armiño que presenta algo mueve la boca un ratito al aparecer.
    const habla = new IntersectionObserver((entradas) => {
      for (const e of entradas) {
        if (!e.isIntersecting) continue;
        const a = e.target as HTMLElement;
        setTimeout(() => (a.dataset.hablando = "true"), 300);
        setTimeout(() => (a.dataset.hablando = "false"), 1900);
        habla.unobserve(a);
      }
    }, { threshold: 0.6 });
    document.querySelectorAll(".charla .armino-vivo, .dice .armino-vivo").forEach((el) => habla.observe(el));
  }

  // El Armiño se asoma al llegar al final de la página y se esconde al subir.
  const asomo = document.querySelector(".asomo")!;
  const chau = asomo.querySelector<HTMLElement>(".armino-vivo")!;
  new IntersectionObserver(([e]) => {
    asomo.classList.toggle("visible", e.isIntersecting);
    if (e.isIntersecting && !quieto) {
      chau.dataset.hablando = "true";
      setTimeout(() => (chau.dataset.hablando = "false"), 1600);
    }
  }, { threshold: 0.5 }).observe(asomo);
</script>
