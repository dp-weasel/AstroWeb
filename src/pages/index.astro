---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { profile } from "../data/profile";
---

<BaseLayout
  title={`${profile.name} · Streamer`}
  description="Streamer nuevo de Guild Wars 2 aprendiendo sobre la marcha. Directos en Twitch, videos en YouTube y comunidad."
>
  <main>
    <Hero title={profile.name} subtitle={profile.tagline} />

    <section class="bio" aria-label="Sobre mí">
      {profile.bio.map((p) => <p>{p}</p>)}
    </section>

    <section aria-labelledby="redes-titulo">
      <h2 id="redes-titulo">Dónde encontrarme</h2>
      <SocialLinks />
    </section>

    <section aria-labelledby="herramientas-titulo">
      <h2 id="herramientas-titulo">Herramientas</h2>
      <a class="tool" href="/gw2/mensajes/">
        <span class="tool-icon" aria-hidden="true">💬</span>
        <span>
          <strong>Mensajes de GW2</strong>
          <span class="tool-desc">Mensajes listos para copiar y pegar en el chat del juego.</span>
        </span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </section>
  </main>
</BaseLayout>

<style>
  main {
    max-width: 36rem;
    margin: 0 auto;
    padding: 0 1rem 4rem;
  }
  section + section { margin-top: 2.5rem; }

  .bio {
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    border-radius: .9rem;
    background: var(--surface);
    font-size: 1.075rem;
  }
  .bio p { margin: 0; }
  .bio p + p { margin-top: .75rem; }

  h2 {
    margin: 0 0 1rem;
    font-size: .8rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .tool {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: .9rem;
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    transition: background-color .15s, border-color .15s;
  }
  .tool:hover { background: var(--surface-hover); border-color: var(--accent); }
  .tool > span:nth-child(2) { display: flex; flex-direction: column; flex: 1; line-height: 1.3; }
  .tool-icon { font-size: 1.5rem; }
  .tool-desc { font-size: .9rem; color: var(--muted); }
  .arrow { color: var(--accent); font-size: 1.25rem; transition: transform .15s; }
  .tool:hover .arrow { transform: translateX(3px); }
</style>
