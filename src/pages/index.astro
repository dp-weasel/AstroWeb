---
// Portada: presentación con enlaces a las redes, cómo es el canal,
// herramientas y preguntas frecuentes. Los textos están en src/data/profile.ts.
import BaseLayout from "../layouts/BaseLayout.astro";
import Logo from "../components/Logo.astro";
import { profile, socials, valores, preguntas } from "../data/profile";

const twitch = socials[0];
const resto = socials.slice(1);

// Igual que en SocialLinks: el negro de X no se vería en modo oscuro, usa el del texto.
const brandColor = (hex: string) => (hex === "000000" ? "currentColor" : `#${hex}`);
---

<BaseLayout
  title={`${profile.name} · Streamer`}
  description="Streamer nuevo de Guild Wars 2 aprendiendo sobre la marcha. Directos en Twitch, videos en YouTube y comunidad."
>
  <main>
    <section class="hero">
      <div class="hero-text">
        <p class="eyebrow"><span class="dot"></span> Streamer en Twitch</p>
        <h1>{profile.name}</h1>
        <p class="lead">{profile.intro}</p>
        <div class="ctas">
          <a class="btn primary" href={twitch.url} target="_blank" rel="noopener me">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={twitch.icon.path} /></svg>
            {twitch.cta}
          </a>
          {resto.map((s) => (
            <a
              class:list={["btn", { youtube: s.icon.slug === "youtube" }]}
              href={s.url}
              target="_blank"
              rel="noopener me"
              aria-label={s.name}
              style={`--brand: ${brandColor(s.icon.hex)}`}
            >
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.icon.path} /></svg>
            </a>
          ))}
        </div>
      </div>
      <div class="hero-art"><Logo size="min(16rem, 60vw)" /></div>
    </section>

    <section aria-labelledby="valores">
      <h2 id="valores">Cómo es el canal</h2>
      <div class="values">
        {valores.map((v) => (
          <article>
            <span class="emoji" aria-hidden="true">{v.emoji}</span>
            <h3>{v.titulo}</h3>
            <p>{v.texto}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="narrow" aria-labelledby="herramientas">
      <h2 id="herramientas">Herramientas</h2>
      <div class="tools">
        <a class="tool-card" href="/gw2/mensajes/">
          <span class="emoji" aria-hidden="true">💬</span>
          <h3>Mensajes de GW2 →</h3>
          <p>Mensajes listos para copiar y pegar en el chat del juego.</p>
        </a>
      </div>
    </section>

    <section class="narrow" aria-labelledby="faq">
      <h2 id="faq">Preguntas frecuentes</h2>
      <div class="faq">
        {preguntas.map((p, i) => (
          <details open={i === 0}>
            <summary>{p.q}</summary>
            <p>{p.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  main { max-width: 60rem; margin: 0 auto; padding: 1rem 1rem 4rem; }
  section + section { margin-top: 4rem; }
  .narrow { max-width: 44rem; margin-inline: auto; }

  /* Presentación */
  .hero {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    align-items: center;
    gap: 2rem;
    padding: 2rem 0 1rem;
  }
  .hero-art :global(.badge) { margin: 0 auto; }
  .eyebrow { display: inline-flex; align-items: center; gap: .5rem; margin: 0; color: var(--accent); font-weight: 700; font-size: .9rem; text-transform: uppercase; letter-spacing: .08em; }
  .dot { width: .6rem; height: .6rem; border-radius: 50%; background: var(--vermilion); animation: pulse 1.6s infinite; }
  @keyframes pulse { 50% { opacity: .3; } }
  @media (prefers-reduced-motion: reduce) { .dot { animation: none; } }
  h1 { font-family: var(--font-display); font-weight: 400; font-size: clamp(2.5rem, 7vw, 4.5rem); line-height: 1; margin: .5rem 0 1rem; }
  .lead { color: var(--muted); font-size: 1.1rem; margin: 0 0 1.5rem; max-width: 32rem; }
  .ctas { display: flex; flex-wrap: wrap; gap: .5rem; }
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: .5rem;
    min-width: 3rem; height: 3rem; padding: 0 1rem;
    border: 1px solid var(--border); border-radius: .75rem;
    background: var(--surface); color: var(--brand, var(--text));
    font-weight: 700; text-decoration: none;
    transition: border-color .15s, transform .15s;
  }
  .btn:hover { border-color: var(--accent); transform: translateY(-2px); }
  .btn svg { width: 1.25rem; height: 1.25rem; fill: currentColor; }
  /* YouTube: botón claro con el ícono en su rojo. En el tema oscuro es gris
     claro en vez de blanco puro, para que no encandile frente a los demás. */
  .btn.youtube { background: #e0e0e0; border-color: #e0e0e0; }
  :global(:root[data-theme="light"]) .btn.youtube { background: #fff; border-color: var(--border); }
  .btn.youtube:hover { border-color: var(--accent); }
  .btn.primary { padding: 0 1.5rem; border: 0; color: #fff; background: linear-gradient(135deg, var(--vermilion), var(--amber)); }

  /* Secciones */
  h2 { text-align: center; font-size: 1.5rem; margin: 0 0 1.5rem; }

  .values { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1rem; }
  .values article { padding: 1.5rem 1.25rem; border-radius: 1.25rem; background: var(--surface); text-align: center; }
  .values .emoji { font-size: 2rem; }
  .values h3 { margin: .5rem 0 .25rem; font-size: 1.05rem; }
  .values p { margin: 0; color: var(--muted); font-size: .95rem; }

  .faq { display: grid; gap: .5rem; }
  details { border: 1px solid var(--border); border-radius: 1rem; background: var(--surface); }
  summary { padding: 1rem 1.25rem; font-weight: 600; cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 1rem; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; color: var(--accent); font-size: 1.25rem; line-height: 1; }
  details[open] summary::after { content: "−"; }
  details p { margin: 0; padding: 0 1.25rem 1rem; color: var(--muted); }
  /* Herramientas */
  .tools { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 1rem; }
  .tool-card {
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: .9rem;
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    transition: border-color .15s;
  }
  .tool-card:hover { border-color: var(--accent); }
  .tool-card .emoji { font-size: 1.75rem; }
  .tool-card h3 { margin: .5rem 0 .25rem; font-size: 1.1rem; }
  .tool-card p { margin: 0; color: var(--muted); }

  @media (max-width: 40rem) {
    .hero { grid-template-columns: 1fr; text-align: center; }
    .hero-art { order: -1; }
    .lead { margin-inline: auto; }
    .ctas { justify-content: center; }
  }
</style>
