---
// Variante 4 · El Armiño te recibe: la mascota (pngTuber) presenta el canal.
// Parpadea, mueve la boca mientras se escribe su bocadillo y, al llegar al
// final de la página, se asoma desde el borde para despedirse.
import VarianteLayout from "../../layouts/VarianteLayout.astro";
import ArminoVivo from "../../components/marca/ArminoVivo.astro";
import Bocadillo from "../../components/marca/Bocadillo.astro";
import Wordmark from "../../components/marca/Wordmark.astro";
import Ctas from "../../components/marca/Ctas.astro";
import { valores, preguntas } from "../../data/variantes-marca";

const lineas = [
  "¡Ey, hola! Soy el Armiño, la mascota de Weasel. Pasá, ponete cómodo.",
  "Weasel streamea Guild Wars 2 (y lo que pinte) y aprende sobre la marcha. Yo superviso. Desde acá.",
  "¿Querés ver el directo? El botón naranja te lleva. Andá, que ya puso la pava.",
];
---

<VarianteLayout slug="armino">
  <main>
    <section class="hero">
      <button class="armino-boton" type="button" aria-label="Que el Armiño siga hablando">
        <ArminoVivo id="anfitrion" size="min(22rem, 70vw)" />
      </button>
      <div class="lado">
        <h1><Wordmark size="clamp(2.5rem, 7vw, 4rem)" /></h1>
        <Bocadillo quien="armino" cola="izquierda" class="dialogo">
          <p id="linea" aria-live="polite" data-lineas={JSON.stringify(lineas)}>{lineas[0]}</p>
          <button class="seguir" type="button" aria-label="Siguiente">▸</button>
        </Bocadillo>
        <Ctas />
      </div>
    </section>

    <section class="contenido" aria-labelledby="valores">
      <h2 id="valores" class="titulo-marca">Cómo es el canal</h2>
      <div class="values">
        {valores.map((v) => (
          <article>
            <span class="emoji" aria-hidden="true">{v.emoji}</span>
            <div><h3>{v.titulo}</h3><p>{v.texto}</p></div>
          </article>
        ))}
      </div>
    </section>

    <section class="contenido" aria-labelledby="faq">
      <h2 id="faq" class="titulo-marca">Lo que más me preguntan</h2>
      <div class="faq">
        {preguntas.map((p, i) => (
          <details open={i === 0}>
            <summary>{p.q}</summary>
            <Bocadillo quien="armino" cola="izquierda" class="respuesta"><p>{p.a}</p></Bocadillo>
          </details>
        ))}
      </div>
      <a class="herramienta" href="/gw2/mensajes/">💬 <strong>Mensajes de GW2</strong> — listos para copiar y pegar en el chat del juego →</a>
    </section>

    <div id="fin" aria-hidden="true"></div>
    <div class="asomado" aria-hidden="true">
      <Bocadillo quien="armino" cola="abajo" class="chau"><p>¿Ya te vas? Seguí a Weasel en Twitch así no te perdés nada 🧉</p></Bocadillo>
      <ArminoVivo size="9rem" />
    </div>
  </main>
</VarianteLayout>

<style>
  main { font-family: var(--font-text); padding-bottom: 8rem; overflow-x: clip; }

  .hero {
    display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 1.5rem;
    max-width: 60rem; margin: 0 auto; padding: 2rem 1rem 1rem;
  }
  .armino-boton {
    padding: 0; border: 0; background: radial-gradient(circle at 50% 55%, color-mix(in srgb, var(--amber) 35%, transparent), transparent 65%);
    cursor: pointer; border-radius: 50%;
    animation: respirar 4s ease-in-out infinite;
  }
  @keyframes respirar { 50% { transform: translateY(-6px) rotate(-1deg); } }
  h1 { margin: 0 0 1.5rem; }
  .lado :global(.dialogo) { min-height: 7.5rem; margin-bottom: 1.5rem; padding-right: 3rem; font-size: 1.2rem; }
  .seguir {
    position: absolute; right: .6rem; bottom: .6rem;
    width: 2rem; height: 2rem; border: 0; border-radius: 50%;
    background: var(--charcoal); color: var(--amber); font-size: 1rem; cursor: pointer;
  }
  .seguir:hover { background: var(--vermilion); color: #fff; }
  #linea.escribiendo::after { content: "▍"; color: var(--vermilion); animation: pulse .8s steps(1) infinite; }
  @keyframes pulse { 50% { opacity: 0; } }

  .contenido { max-width: 46rem; margin: 4rem auto 0; padding: 0 1rem; }
  h2 { font-size: 1.5rem; margin: 0 0 1.5rem; text-align: center; }
  .values { display: grid; gap: .75rem; }
  .values article { display: flex; gap: 1rem; align-items: center; padding: 1rem 1.25rem; border-radius: 1rem; background: var(--surface); }
  .values .emoji { display: grid; place-items: center; flex: none; width: 3.25rem; height: 3.25rem; border-radius: 50%; background: var(--cream); border: 3px solid var(--charcoal); font-size: 1.6rem; }
  .values h3 { margin: 0; font-family: var(--font-bubble); font-weight: 700; font-size: 1.15rem; }
  .values p { margin: 0; color: var(--muted); }

  .faq { display: grid; gap: .5rem; }
  summary { padding: .75rem 1rem; border-radius: 999px; background: var(--surface); font-weight: 700; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary::before { content: "▸ "; color: var(--accent); }
  details[open] summary::before { content: "▾ "; }
  details :global(.respuesta) { margin: 1rem 0 1rem 2.5rem; }
  .herramienta { display: block; margin-top: 2rem; padding: 1rem 1.25rem; border: 2px dashed var(--border); border-radius: 1rem; color: var(--muted); text-decoration: none; text-align: center; }
  .herramienta strong { color: var(--text); }
  .herramienta:hover { border-color: var(--accent); }

  /* El Armiño se asoma desde el borde de abajo a la derecha al llegar al final. */
  .asomado {
    position: fixed; right: 1rem; bottom: 0; z-index: 40;
    display: flex; flex-direction: column; align-items: flex-end;
    transform: translateY(110%); transition: transform .6s cubic-bezier(.3, 1.5, .5, 1);
    pointer-events: none;
  }
  .asomado.visible { transform: translateY(35%); }
  .asomado :global(.chau) { max-width: 15rem; margin: 0 2rem .75rem 0; font-size: .95rem; }

  @media (prefers-reduced-motion: reduce) { .armino-boton, #linea.escribiendo::after { animation: none; } }
  @media (max-width: 44rem) {
    .hero { grid-template-columns: 1fr; justify-items: center; text-align: center; }
    .lado { text-align: left; }
    .lado h1 { text-align: center; }
    .lado :global(.dialogo::after) { left: 50%; top: -.62rem; transform: translateX(-50%) rotate(135deg); }
    .lado :global(.ctas) { justify-content: center; }
    .asomado :global(.chau) { max-width: 12rem; }
  }
</style>

<script>
  const quieto = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const p = document.querySelector<HTMLElement>("#linea")!;
  const armino = document.querySelector<HTMLElement>("#anfitrion")!;
  const lineas: string[] = JSON.parse(p.dataset.lineas!);
  let actual = 0;
  let timer: number | undefined;

  // Escribe la línea letra por letra con la boca moviéndose; después espera y sigue.
  function decir(i: number) {
    actual = i % lineas.length;
    const texto = lineas[actual];
    clearTimeout(timer);
    if (quieto) { p.textContent = texto; return; }
    let n = 0;
    p.classList.add("escribiendo");
    armino.dataset.hablando = "true";
    const paso = () => {
      p.textContent = texto.slice(0, ++n);
      if (n < texto.length) { timer = window.setTimeout(paso, 28); return; }
      p.classList.remove("escribiendo");
      armino.dataset.hablando = "false";
      if (actual < lineas.length - 1) timer = window.setTimeout(() => decir(actual + 1), 3500);
    };
    paso();
  }

  decir(0);
  document.querySelector(".seguir")!.addEventListener("click", () => decir(actual + 1));
  document.querySelector(".armino-boton")!.addEventListener("click", () => decir(actual + 1));

  // Asomarse al final de la página.
  const asomado = document.querySelector(".asomado")!;
  const asomadoArmino = asomado.querySelector<HTMLElement>(".armino-vivo")!;
  new IntersectionObserver(([e]) => {
    asomado.classList.toggle("visible", e.isIntersecting);
    if (e.isIntersecting && !quieto) {
      asomadoArmino.dataset.hablando = "true";
      setTimeout(() => (asomadoArmino.dataset.hablando = "false"), 1600);
    }
  }).observe(document.querySelector("#fin")!);
</script>
