---
// Índice de las variantes de portada con la marca de RecursosCC. No se enlaza
// desde el sitio y no se indexa: es solo para comparar antes de elegir.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { variantes } from "../../data/variantes-marca";
---

<BaseLayout title="Variantes de portada con la marca" noindex>
  <main>
    <h1>Portadas con la marca</h1>
    <p class="intro">
      Cinco propuestas, de la más sencilla a la más creativa, armadas con lo que hay en RecursosCC y las
      escenas de OBS. Dentro de cada una, la barra de abajo (o ← →) pasa a la siguiente. La
      <a href="/">portada actual</a> queda igual.
    </p>
    <ol class="list">
      {variantes.map((v) => (
        <li>
          <a href={`/variantes-marca/${v.slug}/`}>
            <strong>{v.nombre}</strong>
            <span class="idea">{v.idea}</span>
            <ul class="recursos">
              {v.recursos.map((r) => <li>{r}</li>)}
            </ul>
          </a>
        </li>
      ))}
    </ol>
  </main>
</BaseLayout>

<style>
  main { max-width: 44rem; margin: 0 auto; padding: 2rem 1rem 4rem; }
  h1 { font-family: var(--font-display); font-weight: 400; margin: 0 0 .5rem; }
  .intro { color: var(--muted); margin: 0 0 2rem; }
  .intro a { color: var(--accent); }
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .list > li > a {
    display: block;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: .9rem;
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    transition: border-color .15s, transform .15s;
  }
  .list > li > a:hover { border-color: var(--accent); transform: translateY(-2px); }
  strong { font-size: 1.15rem; }
  .idea { display: block; color: var(--muted); margin: .25rem 0 .75rem; }
  .recursos { display: flex; flex-wrap: wrap; gap: .4rem; list-style: none; margin: 0; padding: 0; }
  .recursos li { font-size: .8rem; padding: .15rem .6rem; border-radius: 999px; background: var(--bg); border: 1px solid var(--border); }
</style>
