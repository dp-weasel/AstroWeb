---
// Variante 5 · La escena: la portada como un directo. Ecualizador a 120 BPM
// (Starting Soon), y EDM y el Armiño presentan cada sección charlando con sus
// bocadillos. Las preguntas frecuentes son un chat que se va llenando.
import { Image } from "astro:assets";
import VarianteLayout from "../../layouts/VarianteLayout.astro";
import Wordmark from "../../components/marca/Wordmark.astro";
import ArminoVivo from "../../components/marca/ArminoVivo.astro";
import Bocadillo from "../../components/marca/Bocadillo.astro";
import Ctas from "../../components/marca/Ctas.astro";
import edmSaludando from "../../assets/brand/edm/saludando.png";
import edmCheer from "../../assets/brand/edm/cheer.png";
import edmShrug from "../../assets/brand/edm/shrug.png";
import edmApuntando from "../../assets/brand/edm/apuntando.png";
import edmArriba from "../../assets/brand/edm/feliz-apuntando-arriba.png";
import edmRiendo from "../../assets/brand/edm/riendo-en-el-suelo.png";
import edmGritando from "../../assets/brand/edm/gritando.png";
import edmHiss from "../../assets/brand/edm/hiss.png";
import edmSorprendida from "../../assets/brand/edm/sorprendida.png";
import edmBrazosArriba from "../../assets/brand/edm/brazos-arriba.png";
import ProximoDirecto from "../../components/secciones/ProximoDirecto.astro";
import Horario from "../../components/secciones/Horario.astro";
import Juegos from "../../components/secciones/Juegos.astro";
import Emotes from "../../components/secciones/Emotes.astro";
import Comandos from "../../components/secciones/Comandos.astro";
import Numeros from "../../components/secciones/Numeros.astro";
import Metas from "../../components/secciones/Metas.astro";
import Videos from "../../components/secciones/Videos.astro";
import Reglas from "../../components/secciones/Reglas.astro";
import Apoyar from "../../components/secciones/Apoyar.astro";

const barras = Array.from({ length: 28 }, (_, i) => i);

/** Las preguntas, como mensajes del chat respondidos por los personajes. */
const chat = [
  { de: "mate_amargo", color: "#ff9103", texto: "¿Cuándo hay directo?" },
  { de: "Armiño", quien: "armino", texto: "Los avisos salen en X. Si seguís a Weasel en Twitch, te llega la notificación apenas arranca." },
  { de: "tyria_novata", color: "#4fc3f7", texto: "Soy nueva en Guild Wars 2, ¿puedo pasar igual?" },
  { de: "EDM", quien: "edm", texto: "¡Obvio! Él también es nuevo. Yo le explico todo… y no me hace caso." },
  { de: "charr_cebador", color: "#9ccc65", texto: "¿Para qué son los mensajes de GW2?" },
  { de: "Armiño", quien: "armino", texto: "Mensajes listos para copiar y pegar en el chat del juego: LFG, jefes, etc. Están en Herramientas 👇" },
  { de: "yerba_suave", color: "#f06292", texto: "¿Juega otras cosas?" },
  { de: "EDM", quien: "edm", texto: "Guild Wars 2 es el principal, pero se anima a otros. Tirá sugerencias, que se aburre." },
  { de: "lurker_feliz", color: "#ba68c8", texto: "¿Puedo jugar con Weasel?" },
  { de: "Armiño", quien: "armino", texto: "En los directos de fractales y mundo abierto se arman grupos con el chat. ¡Preguntá en vivo!" },
];

/** Quién presenta cada sección nueva: [personaje, pose de EDM, texto]. */
const presenta = {
  horario: { edm: edmGritando, texto: "¡Anotalo! Si no, después no digas que no te avisé." },
  emotes: { edm: edmSorprendida, texto: "¿Esa soy yo? ¿Y por qué tengo doce caras? Bueno, usalas en el chat." },
  comandos: { edm: edmHiss, texto: "Si escribís !edm, contesto. Si nombrás el mate, opino. No me provoques." },
  metas: { edm: edmBrazosArriba, texto: "Cuando seamos Afiliados quiero mis emotes en Twitch. Es un trato." },
  reglas: { edm: edmShrug, texto: "Son pocas. Hasta Weasel las cumple. Casi siempre." },
};
---

<VarianteLayout slug="escena">
  <main data-escena>
    <!-- 1. El escenario: como la escena de Starting Soon -->
    <section class="escenario">
      <div class="ecualizador" aria-hidden="true">
        {barras.map((i) => <span style={`--i: ${i}; --d: ${(i * 37) % 11}`}></span>)}
      </div>
      <div class="cartel">
        <p class="vivo titulo-marca"><span class="dot"></span> Directos en Twitch</p>
        <h1><Wordmark size="clamp(3rem, 10vw, 6.5rem)" /></h1>
        <p class="sub titulo-marca">Guild Wars 2 · charla · mate</p>
        <Ctas />
      </div>
      <figure class="edm-hero">
        <Bocadillo quien="edm" cola="abajo" class="saludo">
          <p>¿Venís a ver a Weasel? Pasá, ponete cómodo. Yo lo vigilo.</p>
        </Bocadillo>
        <Image class="pose saludando" src={edmSaludando} alt="EDM saludando" width={300} loading="eager" />
        <Image class="pose festejando" src={edmCheer} alt="" width={300} />
      </figure>
    </section>

    <div class="proximo-wrap"><ProximoDirecto /></div>

    <!-- 2. Cómo es el canal, contado por los dos -->
    <section class="charla" aria-labelledby="valores">
      <h2 id="valores" class="titulo-marca">Cómo es el canal</h2>

      <div class="turno aparece">
        <ArminoVivo size="7rem" class="avatar" />
        <Bocadillo quien="armino"><p><strong>Jugamos sin presión.</strong> Weasel aprende sobre la marcha y equivocarse es parte del directo.</p></Bocadillo>
      </div>
      <div class="turno edm aparece">
        <Bocadillo quien="edm" cola="derecha"><p>Y se equivoca seguido, eh.</p></Bocadillo>
        <Image class="avatar" src={edmShrug} alt="EDM encogiéndose de hombros" width={200} />
      </div>
      <div class="turno aparece">
        <ArminoVivo size="7rem" class="avatar" />
        <Bocadillo quien="armino"><p><strong>Buenas charlas.</strong> El chat es parte del juego: preguntá, aconsejá, contá tu anécdota.</p></Bocadillo>
      </div>
      <div class="turno edm aparece">
        <Bocadillo quien="edm" cola="derecha"><p><strong>¡Y crecemos juntos!</strong> Es un canal nuevo. Sumate, que la pava ya está puesta 🧉</p></Bocadillo>
        <Image class="avatar" src={edmArriba} alt="EDM feliz, señalando hacia arriba" width={200} />
      </div>
    </section>

    <!-- Números del canal sobre una banda oscura con el ecualizador -->
    <section class="banda aparece" aria-label="El canal en números"><Numeros /></section>

    <section class="bloque" aria-labelledby="horario">
      <h2 id="horario" class="titulo-marca">Cuándo hay directo</h2>
      <div class="dice aparece"><Image src={presenta.horario.edm} alt="" width={160} /><Bocadillo quien="edm"><p>{presenta.horario.texto}</p></Bocadillo></div>
      <Horario />
    </section>

    <section class="bloque" aria-labelledby="juegos">
      <h2 id="juegos" class="titulo-marca">Qué se juega</h2>
      <Juegos />
    </section>

    <section class="bloque" aria-labelledby="emotes">
      <h2 id="emotes" class="titulo-marca">Los stickers de EDM</h2>
      <div class="dice aparece"><Image src={presenta.emotes.edm} alt="" width={160} /><Bocadillo quien="edm"><p>{presenta.emotes.texto}</p></Bocadillo></div>
      <Emotes />
    </section>

    <section class="bloque angosto" aria-labelledby="comandos">
      <h2 id="comandos" class="titulo-marca">Escribí y pasa algo</h2>
      <div class="dice aparece"><Image src={presenta.comandos.edm} alt="" width={160} /><Bocadillo quien="edm"><p>{presenta.comandos.texto}</p></Bocadillo></div>
      <Comandos />
    </section>

    <section class="bloque angosto" aria-labelledby="metas">
      <h2 id="metas" class="titulo-marca">Camino a Afiliado</h2>
      <div class="dice aparece"><Image src={presenta.metas.edm} alt="" width={160} /><Bocadillo quien="edm"><p>{presenta.metas.texto}</p></Bocadillo></div>
      <Metas />
    </section>

    <section class="bloque" aria-labelledby="videos">
      <h2 id="videos" class="titulo-marca">Lo último en YouTube</h2>
      <Videos cantidad={3} />
    </section>

    <!-- 3. Preguntas frecuentes como un chat de Twitch -->
    <section class="chat-wrap" aria-labelledby="faq">
      <h2 id="faq" class="titulo-marca">Preguntas del chat</h2>
      <ol class="chat">
        {chat.map((m) => (
          <li class:list={["msg", "aparece", m.quien]}>
            {m.quien && <span class="insignia" aria-hidden="true">{m.quien === "edm" ? "🐱" : "🎧"}</span>}
            <strong style={m.color ? `color: ${m.color}` : undefined}>{m.de}:</strong> {m.texto}
          </li>
        ))}
      </ol>
    </section>

    <section class="bloque angosto" aria-labelledby="reglas">
      <h2 id="reglas" class="titulo-marca">Reglas de la casa</h2>
      <div class="dice aparece"><Image src={presenta.reglas.edm} alt="" width={160} /><Bocadillo quien="edm"><p>{presenta.reglas.texto}</p></Bocadillo></div>
      <Reglas />
    </section>

    <!-- 4. Herramientas: EDM señala la tarjeta -->
    <section class="herramientas" aria-labelledby="herramientas">
      <h2 id="herramientas" class="titulo-marca">Herramientas</h2>
      <div class="señala aparece">
        <a class="tool-card" href="/gw2/mensajes/">
          <span class="emoji" aria-hidden="true">💬</span>
          <span><strong>Mensajes de GW2 →</strong><br />Listos para copiar y pegar en el chat del juego.</span>
        </a>
        <Image class="edm-apunta" src={edmApuntando} alt="EDM señalando la herramienta" width={240} />
      </div>
    </section>

    <section class="bloque" aria-labelledby="apoyar">
      <h2 id="apoyar" class="titulo-marca">¿Querés dar una mano?</h2>
      <div class="dice aparece"><ArminoVivo size="5rem" /><Bocadillo quien="armino"><p>Todo suma, y casi todo es gratis. EDM igual prefiere los cafecitos.</p></Bocadillo></div>
      <Apoyar />
    </section>

    <!-- 5. Cierre -->
    <section class="cierre aparece">
      <Image src={edmRiendo} alt="EDM tirada en el suelo, muerta de risa" width={260} />
      <Bocadillo quien="edm" cola="izquierda"><p>¡Nos vemos en el próximo directo! Traé el mate.</p></Bocadillo>
    </section>
  </main>
</VarianteLayout>

<style>
  main { font-family: var(--font-text); padding-bottom: 7rem; overflow-x: clip; }
  h2 { text-align: center; font-size: clamp(1.5rem, 4vw, 2rem); margin: 0 0 2rem; }

  /* ---------- Escenario (siempre oscuro, como la escena) ---------- */
  .escenario {
    position: relative; overflow: hidden;
    display: grid; grid-template-columns: 1.4fr 1fr; align-items: end; gap: 1rem;
    min-height: min(36rem, 85vh);
    padding: 3rem max(1rem, calc((100vw - 60rem) / 2)) 0;
    background: radial-gradient(ellipse at 30% 20%, #3a2a20, var(--charcoal) 60%);
    color: var(--snow);
  }
  .ecualizador {
    position: absolute; inset: auto 0 0 0; height: 45%;
    display: flex; align-items: flex-end; gap: .4%; padding: 0 1%;
    opacity: .35; pointer-events: none;
  }
  .ecualizador span {
    flex: 1; height: 100%; border-radius: .3rem .3rem 0 0;
    background: linear-gradient(to top, var(--vermilion), var(--amber));
    transform-origin: bottom;
    transform: scaleY(calc(.15 + var(--d) * .06));
    /* 120 BPM: un pulso cada 0,5 s, cada barra con su desfase. */
    animation: latir .5s calc(var(--d) * -.045s) ease-in-out infinite alternate;
  }
  @keyframes latir { to { transform: scaleY(calc(.25 + (10 - var(--d)) * .07)); } }
  .cartel { position: relative; align-self: center; padding-bottom: 3rem; }
  .vivo { display: inline-flex; align-items: center; gap: .5rem; margin: 0; color: var(--amber); }
  .dot { width: .6rem; height: .6rem; border-radius: 50%; background: var(--vermilion); animation: pulse 1s infinite; }
  @keyframes pulse { 50% { opacity: .3; } }
  h1 { margin: .5rem 0; line-height: 1; }
  .sub { margin: 0 0 1.5rem; font-size: clamp(1.1rem, 3vw, 1.6rem); text-shadow: 0 .15rem .5rem #000; }
  .escenario :global(.btn:not(.primary):not(.youtube)) { background: #2b2b2b; border-color: #3d3d3d; }
  .escenario :global(.btn[aria-label^="X"]) { color: var(--snow); }

  .edm-hero { position: relative; margin: 0; display: grid; justify-items: center; }
  .edm-hero :global(.saludo) { max-width: 16rem; margin-bottom: 1rem; animation: flotar 3s ease-in-out infinite; }
  @keyframes flotar { 50% { transform: translateY(-.4rem); } }
  .pose { display: block; width: min(15rem, 40vw); height: auto; grid-area: 2 / 1; transition: opacity .2s, transform .3s; }
  .festejando { opacity: 0; transform: translateY(1rem); }
  /* Al pasar por el botón de Twitch, EDM festeja. */
  .escenario:has([data-cta="twitch"]:hover, [data-cta="twitch"]:focus-visible) .saludando { opacity: 0; }
  .escenario:has([data-cta="twitch"]:hover, [data-cta="twitch"]:focus-visible) .festejando { opacity: 1; transform: none; }

  /* ---------- Secciones nuevas ---------- */
  .proximo-wrap { max-width: 40rem; margin: -1.5rem auto 0; padding: 0 1rem; position: relative; z-index: 2; }
  .bloque { max-width: 60rem; margin: 5rem auto 0; padding: 0 1rem; }
  .bloque.angosto { max-width: 46rem; }
  .dice { display: flex; align-items: center; gap: 1rem; max-width: 34rem; margin: -.75rem auto 1.75rem; }
  .dice img { width: 4.5rem; height: auto; flex: none; }
  .dice :global(.bocadillo) { flex: 1; }
  .banda {
    margin-top: 5rem; padding: 2rem 1rem;
    background: repeating-linear-gradient(90deg, rgb(255 145 3 / .08) 0 .6rem, transparent .6rem 1.4rem), var(--charcoal);
    border-block: 4px solid var(--amber);
  }
  .banda :global(dt) { color: #bdbdbd; }

  /* ---------- Charla de los personajes ---------- */
  .charla { max-width: 46rem; margin: 5rem auto 0; padding: 0 1rem; display: grid; gap: 1.5rem; }
  .turno { display: flex; align-items: center; gap: 1rem; }
  .turno.edm { justify-content: flex-end; }
  .turno :global(.bocadillo) { flex: 0 1 30rem; }
  .turno :global(.avatar) { flex: none; }
  .turno img.avatar, .turno :global(img.avatar) { width: 6.5rem; height: auto; }

  /* ---------- Chat ---------- */
  .chat-wrap { max-width: 40rem; margin: 5rem auto 0; padding: 0 1rem; }
  .chat {
    list-style: none; margin: 0; padding: 1rem 1.25rem;
    border: 6px solid var(--charcoal); border-radius: 28px;
    background: var(--surface); box-shadow: 0 0 0 2px var(--amber);
    display: grid; gap: .6rem; font-size: .98rem;
  }
  .msg { line-height: 1.45; }
  .msg.armino, .msg.edm { padding: .5rem .75rem; border-radius: .75rem; font-family: var(--font-bubble); font-weight: 500; }
  .msg.armino { background: color-mix(in srgb, var(--amber) 14%, transparent); }
  .msg.armino strong { color: var(--accent); }
  .msg.edm { background: color-mix(in srgb, var(--magenta) 16%, transparent); }
  .msg.edm strong { color: var(--magenta); }
  .insignia { margin-right: .3rem; }

  /* ---------- Herramientas ---------- */
  .herramientas { max-width: 40rem; margin: 5rem auto 0; padding: 0 1rem; }
  .señala { position: relative; padding-right: 7rem; }
  .tool-card {
    display: flex; gap: 1rem; align-items: center; padding: 1.25rem;
    border: 3px solid var(--charcoal); border-radius: 1.25rem; background: var(--cream);
    color: var(--charcoal); text-decoration: none; box-shadow: .35rem .35rem 0 var(--amber);
    transition: transform .15s;
  }
  .tool-card:hover { transform: translate(-.15rem, -.15rem); box-shadow: .5rem .5rem 0 var(--amber); }
  .tool-card .emoji { font-size: 2rem; }
  .tool-card strong { font-size: 1.1rem; }
  .edm-apunta { position: absolute; right: -1rem; top: 50%; width: 8rem; height: auto; transform: translateY(-45%); }

  /* ---------- Cierre ---------- */
  .cierre { display: flex; align-items: center; justify-content: center; gap: 1rem; max-width: 40rem; margin: 5rem auto 0; padding: 0 1rem; }
  .cierre img { width: 9rem; height: auto; }

  /* ---------- Aparición al hacer scroll ---------- */
  :global(.js) .aparece { opacity: 0; transform: translateY(1.5rem); transition: opacity .5s, transform .5s; }
  :global(.js) .aparece.visible { opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    .ecualizador span, .dot, .edm-hero :global(.saludo) { animation: none; }
  }
  @media (max-width: 44rem) {
    .escenario { grid-template-columns: 1fr; text-align: center; padding-top: 2rem; }
    .escenario :global(.ctas) { justify-content: center; }
    .cartel { padding-bottom: 0; }
    .turno img.avatar, .turno :global(.avatar) { width: 4.5rem !important; }
    .señala { padding-right: 4.5rem; }
    .edm-apunta { width: 6rem; }
  }
</style>

<script>
  // Las cosas aparecen al entrar en pantalla; en el chat, un mensaje tras otro.
  const quieto = matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!quieto && "IntersectionObserver" in window) {
    document.documentElement.classList.add("js");
    const io = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (!e.isIntersecting) continue;
          const el = e.target as HTMLElement;
          const enChat = el.classList.contains("msg");
          const i = enChat ? [...el.parentElement!.children].indexOf(el) : 0;
          setTimeout(() => el.classList.add("visible"), enChat ? (i % 10) * 400 : 0);
          io.unobserve(el);
        }
      },
      { threshold: 0.3 },
    );
    document.querySelectorAll(".aparece").forEach((el) => io.observe(el));

    // Cada Armiño de la charla mueve la boca un ratito al aparecer.
    const habla = new IntersectionObserver((entradas) => {
      for (const e of entradas) {
        if (!e.isIntersecting) continue;
        const a = e.target as HTMLElement;
        setTimeout(() => (a.dataset.hablando = "true"), 300);
        setTimeout(() => (a.dataset.hablando = "false"), 1900);
        habla.unobserve(a);
      }
    }, { threshold: 0.6 });
    document.querySelectorAll(".charla .armino-vivo").forEach((el) => habla.observe(el));
  }
</script>
