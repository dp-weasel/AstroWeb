---
// Variante 3 · Chillchat: la web vestida como la escena de charla. Manchas óxido
// de los fondos chillchat a los costados, el Armiño en un marco de cámara con el
// anillo de la escena Juego (20 s por vuelta) y WEASEL montado sobre el borde.
import { getImage } from "astro:assets";
import VarianteLayout from "../../layouts/VarianteLayout.astro";
import Wordmark from "../../components/marca/Wordmark.astro";
import ArminoVivo from "../../components/marca/ArminoVivo.astro";
import Ctas from "../../components/marca/Ctas.astro";
import tira from "../../assets/brand/fondos/manchas-tira.png";
import ProximoDirecto from "../../components/secciones/ProximoDirecto.astro";
import Rincon from "../../components/secciones/Rincon.astro";
import Reglas from "../../components/secciones/Reglas.astro";
import Emotes from "../../components/secciones/Emotes.astro";
import Metas from "../../components/secciones/Metas.astro";
import { intro, valores, preguntas } from "../../data/variantes-marca";

// Tira de manchas recortada de back-chillchat-002.png; se usa como fondo CSS.
const manchas = await getImage({ src: tira, format: "webp", width: 275 });
---

<VarianteLayout slug="chillchat">
  <main style={`--manchas: url(${manchas.src})`}>
    <section class="escena">
      <div class="marco">
        <div class="anillo" aria-hidden="true"></div>
        <div class="cam">
          <ArminoVivo size="100%" />
        </div>
        <div class="nombre"><Wordmark size="clamp(2rem, 6vw, 3rem)" /></div>
      </div>
      <div class="texto">
        <p class="vivo titulo-marca"><span class="dot"></span> Charla, juegos y mate</p>
        <h1 class="titulo-marca">Pasá, que hay lugar</h1>
        <p class="lead">{intro}</p>
        <Ctas />
        <ProximoDirecto class="proximo-hero" />
      </div>
    </section>

    <div class="contenido">
      <section aria-labelledby="valores">
        <h2 id="valores" class="titulo-marca">Cómo es el canal</h2>
        <div class="values">
          {valores.map((v) => (
            <article class="ventana">
              <span class="emoji" aria-hidden="true">{v.emoji}</span>
              <h3>{v.titulo}</h3>
              <p>{v.texto}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="ventana" aria-labelledby="rincon">
        <h2 id="rincon" class="titulo-marca">El rincón</h2>
        <p class="bajada">Desde dónde se transmite. Todo armado de a poco, como el canal.</p>
        <Rincon />
      </section>

      <div class="dos parejo">
        <section class="ventana" aria-labelledby="reglas">
          <h2 id="reglas" class="titulo-marca">Las reglas de la casa</h2>
          <Reglas />
        </section>
        <section class="ventana" aria-labelledby="metas">
          <h2 id="metas" class="titulo-marca">Metas</h2>
          <Metas />
        </section>
      </div>

      <section class="ventana" aria-labelledby="emotes">
        <h2 id="emotes" class="titulo-marca">Los stickers de EDM</h2>
        <Emotes />
      </section>

      <div class="dos">
        <section class="ventana" aria-labelledby="faq">
          <h2 id="faq" class="titulo-marca">Preguntas</h2>
          {preguntas.map((p, i) => (
            <details open={i === 0}>
              <summary>{p.q}</summary>
              <p>{p.a}</p>
            </details>
          ))}
        </section>
        <a class="ventana herramienta" href="/gw2/mensajes/">
          <span class="emoji" aria-hidden="true">💬</span>
          <h2 class="titulo-marca">Mensajes de GW2</h2>
          <p>Listos para copiar y pegar en el chat del juego.</p>
          <span class="ir">Abrir →</span>
        </a>
      </div>
    </div>
  </main>
</VarianteLayout>

<style>
  main {
    position: relative;
    font-family: var(--font-text);
    padding-bottom: 6rem;
    /* Manchas óxido en los dos bordes de la página, como en los fondos de charla. */
    background: var(--manchas) right top / clamp(3rem, 9vw, 9rem) auto repeat-y;
  }
  /* La de la izquierda, espejada para que no se vean iguales. */
  main::before {
    content: ""; position: absolute; inset: 0 auto 0 0; width: clamp(3rem, 9vw, 9rem);
    background: var(--manchas) center top / 100% auto repeat-y; transform: scaleX(-1); z-index: 0;
  }
  main > * { position: relative; z-index: 1; }

  .escena {
    display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 3rem;
    max-width: 58rem; margin: 0 auto; padding: 3rem 1.5rem 2rem;
  }

  /* Marco de cámara: esquinas de 28px, borde carbón y anillo naranja girando. */
  .marco { position: relative; width: min(20rem, 70vw); aspect-ratio: 4 / 5; }
  .anillo {
    position: absolute; inset: -6px; border-radius: 34px; overflow: hidden;
  }
  .anillo::before {
    content: ""; position: absolute; inset: -50%;
    background: conic-gradient(var(--amber) 0 25%, var(--charcoal) 25% 50%, var(--vermilion) 50% 75%, var(--charcoal) 75%);
    animation: girar 20s linear infinite;
  }
  @keyframes girar { to { transform: rotate(1turn); } }
  .cam {
    position: absolute; inset: 0; border-radius: 28px; overflow: hidden;
    display: grid; place-items: end center;
    background: radial-gradient(circle at 50% 35%, #3a3a3a, var(--charcoal) 70%);
    box-shadow: inset 0 0 2rem rgb(0 0 0 / .6);
  }
  .cam :global(.armino-vivo) { width: 105%; margin-bottom: -8%; }
  .nombre { position: absolute; left: 50%; bottom: 0; transform: translate(-50%, 50%); }

  .vivo { display: inline-flex; align-items: center; gap: .5rem; margin: 0; color: var(--accent); font-size: .9rem; }
  .dot { width: .6rem; height: .6rem; border-radius: 50%; background: var(--vermilion); animation: pulse 1.6s infinite; }
  @keyframes pulse { 50% { opacity: .3; } }
  h1 { font-size: clamp(2rem, 5vw, 3.25rem); line-height: 1.05; margin: .5rem 0 1rem; }
  .lead { color: var(--muted); font-size: 1.1rem; font-weight: 500; margin: 0 0 1.5rem; }

  .contenido { max-width: 54rem; margin: 3rem auto 0; padding: 0 1.5rem; }
  .contenido > * + * { margin-top: 2rem; }
  h2 { font-size: 1.4rem; margin: 0 0 1rem; }

  /* "Ventanas" como los huecos de cámara de las escenas. */
  .ventana {
    padding: 1.5rem;
    border: 6px solid var(--charcoal);
    border-radius: 28px;
    background: var(--surface);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--rust) 70%, transparent), 0 1rem 2rem rgb(0 0 0 / .3);
  }
  .values { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1.25rem; }
  .values .emoji { font-size: 2rem; }
  .values h3 { margin: .5rem 0 .25rem; font-weight: 800; }
  .values p { margin: 0; color: var(--muted); }

  .bajada { margin: -.5rem 0 1rem; color: var(--muted); }
  .texto :global(.proximo-hero) { margin-top: 1.5rem; }
  .ventana :global(li), .ventana :global(.ficha) { background: var(--bg); }
  .dos.parejo { grid-template-columns: 1fr 1fr; }
  .dos { display: grid; grid-template-columns: 1.6fr 1fr; gap: 1.25rem; align-items: start; }
  details + details { border-top: 1px solid var(--border); }
  summary { padding: .75rem 0; font-weight: 700; cursor: pointer; }
  summary::marker { color: var(--accent); }
  details p { margin: 0 0 .75rem; color: var(--muted); }
  .herramienta { display: block; color: var(--text); text-decoration: none; transition: transform .15s; }
  .herramienta:hover { transform: translateY(-4px) rotate(-1deg); }
  .herramienta .emoji { font-size: 2.5rem; }
  .herramienta p { color: var(--muted); margin: 0 0 1rem; }
  .ir { color: var(--accent); font-weight: 800; }

  @media (prefers-reduced-motion: reduce) { .anillo::before, .dot { animation: none; } }
  @media (max-width: 44rem) {
    .escena { grid-template-columns: 1fr; justify-items: center; text-align: center; gap: 3.5rem; padding-inline: clamp(3.25rem, 9vw, 9rem); }
    .marco { width: 100%; max-width: 18rem; }
    .escena :global(.ctas) { justify-content: center; }
    .dos, .dos.parejo { grid-template-columns: 1fr; }
    .contenido { padding: 0 clamp(3.25rem, 9vw, 9rem); }
  }
</style>
