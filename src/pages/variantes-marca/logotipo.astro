---
// Variante 1 · Marca aplicada: misma estructura que la portada actual, con las
// fuentes y el logotipo de las escenas de OBS.
import VarianteLayout from "../../layouts/VarianteLayout.astro";
import Logo from "../../components/Logo.astro";
import Wordmark from "../../components/marca/Wordmark.astro";
import Ctas from "../../components/marca/Ctas.astro";
import { intro, valores, preguntas } from "../../data/variantes-marca";
---

<VarianteLayout slug="logotipo">
  <main>
    <section class="hero">
      <div class="hero-text">
        <p class="eyebrow titulo-marca"><span class="dot"></span> Streamer en Twitch</p>
        <h1><Wordmark size="clamp(3rem, 11vw, 5.5rem)" /><span class="sr-only"> Shiro</span></h1>
        <p class="lead">{intro}</p>
        <Ctas />
      </div>
      <div class="hero-art"><Logo size="min(17rem, 60vw)" /></div>
    </section>

    <section aria-labelledby="valores">
      <h2 id="valores" class="titulo-marca">Cómo es el canal</h2>
      <div class="values">
        {valores.map((v) => (
          <article>
            <span class="emoji" aria-hidden="true">{v.emoji}</span>
            <h3>{v.titulo}</h3>
            <p>{v.texto}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="narrow" aria-labelledby="herramientas">
      <h2 id="herramientas" class="titulo-marca">Herramientas</h2>
      <a class="tool-card" href="/gw2/mensajes/">
        <span class="emoji" aria-hidden="true">💬</span>
        <span><strong>Mensajes de GW2 →</strong><br />Listos para copiar y pegar en el chat del juego.</span>
      </a>
    </section>

    <section class="narrow" aria-labelledby="faq">
      <h2 id="faq" class="titulo-marca">Preguntas frecuentes</h2>
      <div class="faq">
        {preguntas.map((p, i) => (
          <details open={i === 0}>
            <summary>{p.q}</summary>
            <p>{p.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
</VarianteLayout>

<style>
  main { max-width: 60rem; margin: 0 auto; padding: 1rem 1rem 6rem; font-family: var(--font-text); }
  section + section { margin-top: 4rem; }
  .narrow { max-width: 44rem; margin-inline: auto; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }

  .hero { display: grid; grid-template-columns: 1.3fr 1fr; align-items: center; gap: 2rem; padding: 2rem 0 1rem; }
  .eyebrow { display: inline-flex; align-items: center; gap: .5rem; margin: 0; color: var(--accent); font-size: .95rem; }
  .dot { width: .6rem; height: .6rem; border-radius: 50%; background: var(--vermilion); animation: pulse 1.6s infinite; }
  @keyframes pulse { 50% { opacity: .3; } }
  h1 { margin: .5rem 0 1rem; line-height: 1; }
  .lead { color: var(--muted); font-size: 1.1rem; font-weight: 500; margin: 0 0 1.5rem; max-width: 32rem; }

  h2 { text-align: center; font-size: 1.6rem; margin: 0 0 1.5rem; }
  .values { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1rem; }
  .values article { padding: 1.5rem 1.25rem; border-radius: 1.25rem; background: var(--surface); text-align: center; border-bottom: 4px solid var(--amber); }
  .values .emoji { font-size: 2rem; }
  .values h3 { margin: .5rem 0 .25rem; font-size: 1.05rem; font-weight: 800; }
  .values p { margin: 0; color: var(--muted); font-size: .95rem; }

  .tool-card {
    display: flex; gap: 1rem; align-items: center; padding: 1.25rem;
    border: 1px solid var(--border); border-radius: .9rem; background: var(--surface);
    color: var(--muted); text-decoration: none; transition: border-color .15s;
  }
  .tool-card strong { color: var(--text); font-size: 1.1rem; }
  .tool-card:hover { border-color: var(--accent); }
  .tool-card .emoji { font-size: 2rem; }

  .faq { display: grid; gap: .5rem; }
  details { border: 1px solid var(--border); border-radius: 1rem; background: var(--surface); }
  summary { padding: 1rem 1.25rem; font-weight: 700; cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 1rem; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; color: var(--accent); font-size: 1.25rem; line-height: 1; }
  details[open] summary::after { content: "−"; }
  details p { margin: 0; padding: 0 1.25rem 1rem; color: var(--muted); }

  @media (prefers-reduced-motion: reduce) { .dot { animation: none; } }
  @media (max-width: 40rem) {
    .hero { grid-template-columns: 1fr; text-align: center; }
    .hero-art { order: -1; }
    .lead { margin-inline: auto; }
    .hero :global(.ctas) { justify-content: center; }
  }
</style>
